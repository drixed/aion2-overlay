@* aion2-overlay fork: new file (see FORK_CHANGES.md). *@
@using System.Globalization
@using AionDpsMeter.Timers.Feed
@implements IDisposable

@if (ViewModel != null)
{
    <div class="boss-panel @PanelClasses @(Options.FocusMode && Fight is not null ? "bp-focus" : "")" @ref="panel" style="zoom:@(Options.UiScale)%;@PanelStyle">
        <div class="bp-header" @onmousedown="ViewModel.BeginDrag">
            <span class="bp-dot @(Fight is not null ? "bp-dot--fight" : "")"></span>
            <span class="bp-title" title="@HeaderTitle">@HeaderTitle</span>
            <div class="bp-mode-wrap" @onmousedown:stopPropagation="true">
                <button type="button" class="bp-mode" @onclick="ToggleModeMenu" title="@ModeHint(Mode)">@ModeLabel(Mode) ▾</button>
            </div>
            <span class="bp-time">@ViewModel.CombatDuration</span>
            <span class="bp-ping" style="color:@ViewModel.PingColor">@ViewModel.PingDisplay</span>
            <div class="bp-controls">
                <button type="button" @onclick="ViewModel.OpenHistory" @onmousedown:stopPropagation="true" title="История боёв">☰</button>
                <button type="button" @onclick="ViewModel.OpenStatEffCalc" @onmousedown:stopPropagation="true" title="Калькулятор статов">⚔</button>
                <button type="button" @onclick="ToggleCubeMap" @onmousedown:stopPropagation="true" title="Карта кубов">🗺</button>
                <button type="button" @onclick="ViewModel.OpenSettings" @onmousedown:stopPropagation="true" title="Настройки">⚙</button>
                <button type="button" @onclick="ViewModel.Minimize" @onmousedown:stopPropagation="true" title="Свернуть">_</button>
                <button type="button" @onclick="ViewModel.Close" @onmousedown:stopPropagation="true" title="Закрыть">✕</button>
            </div>
        </div>
        @if (modeMenuOpen)
        {
            @* a row under the header, not a dropdown: the window fits its content, a dropdown was cut off *@
            <div class="bp-mode-menu">
                @foreach (var m in AllModes)
                {
                    <button type="button" class="@(m == Options.Mode ? "is-on" : "")" title="@ModeHint(m)" @onclick="() => PickMode(m)">@ModeLabel(m)</button>
                }
            </div>
        }
        @if (PetNews() is { } petNews)
        {
            <div class="bp-record-news bp-pet-news">🐾 @petNews</div>
        }
        @if (RecordNews() is { } recordNews)
        {
            <div class="bp-record-news">🏆 @recordNews</div>
        }
        @if (AlertText is { } alertText)
        {
            <div class="bp-alert">🔔 @alertText</div>
        }
        @if (ActiveNotice is { } notice && !Compact)
        {
            <div class="bp-notice">
                <span class="bp-notice-icon">⚠</span>
                <span class="bp-notice-title" title="@notice.Title">@notice.Title</span>
                <button type="button" class="bp-notice-btn" @onclick="ToggleNotice">@(noticeOpen ? "Скрыть" : "Читать")</button>
            </div>
            @if (noticeOpen)
            {
                <div class="bp-notice-body">
                    <h3>@notice.Title</h3>
                    @foreach (var paragraph in Paragraphs(notice.Text))
                    {
                        <p>@paragraph</p>
                    }
                    <div class="bp-notice-actions">
                        <button type="button" class="bp-link" @onclick="RemindLater">Напомнить позже</button>
                        <button type="button" class="bp-primary" @onclick="DismissNotice">Понятно</button>
                    </div>
                </div>
            }
        }
        @if (Fight is { } f && !noticeOpen && !Compact)
        {
            <div class="bp-card">
                <div class="bp-card-top">
                    <span class="bp-skull">@(fightIsBoss ? "☠" : "◎")</span>
                    <span class="bp-name" title="@f.Name">@f.Name</span>
                    <span class="bp-hp">@Hp(f.HpCurrent) / @Hp(f.HpTotal) · <b>@f.HpPercent.ToString("0", CultureInfo.InvariantCulture)%</b></span>
                </div>
                @if (!Options.HideBossHpBar)
                {
                    <div class="bp-track"><div class="bp-fill" style="width:@(f.HpPercent.ToString("0.##", CultureInfo.InvariantCulture))%"></div></div>
                }
                @if (RecordLine(f) is { } rec)
                {
                    <div class="bp-record">🏆 @rec.Text @if (rec.Pace is not null) { <b class="@(rec.Faster ? "bp-win" : "bp-rage")">· @rec.Pace</b> }</div>
                }
                <div class="bp-card-bottom">
                    <span>До победы <b class="bp-win">@(f.ToKill is { } k ? FeedText.Span(k) : "—")</b></span>
                    @if (ShowPartyDps && Options.ShowPartyDps)
                    {
                        <span>Группа <b>@PartyDpsText</b></span>
                    }
                    @if (f.Enrage is not null && Options.ShowEnrage)
                    {
                        <span>До ярости <b class="@(f.Enraged ? "bp-rage" : "bp-enrage")">@(f.Enraged ? "ярость!" : FeedText.Span(f.ToEnrage!.Value))</b></span>
                    }
                </div>
            </div>
        }
        @if (ViewModel.UpdateAvailable && !noticeOpen && !Compact)
        {
            <div class="bp-notice">
                <span class="bp-notice-icon">⬆</span>
                <span class="bp-notice-title">@ViewModel.UpdateVersionText</span>
                <button type="button" class="bp-notice-btn" @onclick="ViewModel.OpenWhatsNew">Что нового</button>
                <button type="button" class="bp-link" @onclick="ViewModel.DismissUpdate">✕</button>
            </div>
        }
        @if (!noticeOpen && PetLine is { } petLine)
        {
            <div class="bp-pet" title="@PetTitle(petLine)">
                <span class="bp-pet-name">🐾 @PetName(petLine)</span>
                <span class="bp-pet-stat">@PetStat(petLine.Pet)</span>
                @if (petLine.Pet.Souls is { } petSouls)
                {
                    <i class="bp-pet-bar" style="width:@((Math.Min(100, petSouls * 100 / Math.Max(1, petLine.Pet.Need))).ToString(CultureInfo.InvariantCulture))%"></i>
                }
            </div>
        }
        @if (!noticeOpen && ModeStatus() is { } modeStatus)
        {
            <div class="bp-mode-status">
                <span>@modeStatus</span>
                @if (Mode == AionDpsMeter.Timers.Modes.MeterMode.Grind)
                {
                    <button type="button" class="bp-notice-btn" @onclick="ToggleGrind">@GrindButton</button>
                }
            </div>
        }
        @if (!noticeOpen && recapPlayer is { } recapId)
        {
            var recap = modes.Deaths.LastFor(recapId);
            <div class="bp-recap">
                <div class="bp-recap-head">
                    <b>💀 @RecapName(recapId)</b>
                    @if (recap is not null)
                    {
                        <span>@recap.At.ToString("HH:mm:ss") · получено @AionDpsMeter.UI.Utils.DamageFormatter.Format(recap.Total) за 6 с</span>
                    }
                    <button type="button" class="bp-link" @onclick="() => recapPlayer = null">✕</button>
                </div>
                @if (recap is null || recap.Hits.Count == 0)
                {
                    <div class="bp-recap-empty">Ударов перед смертью не видно: урон от окружения, или смерть была до запуска метра</div>
                }
                else
                {
                    @foreach (var hit in recap.Hits)
                    {
                        <div class="bp-recap-row @(ReferenceEquals(hit, recap.KillingBlow) ? "is-kill" : "")">
                            <span class="bp-recap-t">@((hit.At - recap.At).TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture)) с</span>
                            <span class="bp-recap-src">@hit.Source</span>
                            <span class="bp-recap-sk">@hit.Skill</span>
                            <span class="bp-recap-dmg">@AionDpsMeter.UI.Utils.DamageFormatter.Format(hit.Damage)@(hit.Critical ? " ✦" : "")</span>
                        </div>
                    }
                }
            </div>
        }
        <div class="bp-players" style="@(noticeOpen ? "display:none" : "")">
            @if (AltMode)
            {
                @foreach (var (r, altRank) in OrderedAltRows())
                {
                    <div class="bp-row @(r.IsUser ? "bp-row--me" : "")">
                        <div class="bp-row-bar @AltRowClass(r)" style="width:@(r.Bar.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                        @if (Options.RankNumbers)
                        {
                            <span class="bp-row-rank">@altRank</span>
                        }
                        <span class="bp-row-icon" style="background-image:url('/images/classes/@(r.ClassId).png')"></span>
                        <span class="bp-row-name">@r.Name</span>
                        <span class="bp-row-gauge"><i class="@AltRowClass(r)" style="width:@(r.Bar.ToString("0.##", CultureInfo.InvariantCulture))%"></i></span>
                        <span class="bp-row-dmg">@AionDpsMeter.UI.Utils.DamageFormatter.Format(r.Total) (@r.Share.ToString("0.0", CultureInfo.InvariantCulture)%)</span>
                        <span class="bp-row-dps">@AionDpsMeter.UI.Utils.DamageFormatter.Format(r.PerSecond)<small>/s</small></span>
                    </div>
                }
            }
            else
            {
            @foreach (var (player, share, bar, rank) in OrderedRows())
            {
                <div class="bp-row @ViewModel.GetIsUserClass(player)" @onclick="() => ViewModel.OpenPlayerDetails(player)">
                    <div class="bp-row-bar @ViewModel.GetPlayerRowClass(player)" style="width:@(bar.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                    @if (Options.RankNumbers)
                    {
                        <span class="bp-row-rank">@rank</span>
                    }
                    <span class="bp-row-icon" style="background-image:url('/images/classes/@(player.ClassId).png')"></span>
                    <span class="bp-row-name">@player.PlayerNameDisplay</span>
                    <span class="bp-row-gauge"><i class="@ViewModel.GetPlayerRowClass(player)" style="width:@(bar.ToString("0.##", CultureInfo.InvariantCulture))%"></i></span>
                    @if (player.IsUser && VsBest() is { } vs)
                    {
                        <span class="bp-row-vs @(vs.StartsWith('+') ? "bp-row-vs--up" : vs.StartsWith('−') ? "bp-row-vs--down" : "")"
                              title="@($"Твой DPS против твоего лучшего на этом боссе ({AionDpsMeter.UI.Utils.DamageFormatter.Format(FightRecord!.BestMyDps)}/s)")">@vs</span>
                    }
                    <span class="bp-row-cp">@PowerOf(player)</span>
                    @if (string.IsNullOrWhiteSpace(player.DeathsDisplay))
                    {
                        <span class="bp-row-death"></span>
                    }
                    else
                    {
                        <span class="bp-row-death bp-row-death--click" title="Разбор смерти: что прилетело за 6 секунд до неё"
                              @onclick="() => ToggleRecap(player.PlayerId)" @onclick:stopPropagation="true">@player.DeathsDisplay</span>
                    }
                    @if (Mode == AionDpsMeter.Timers.Modes.MeterMode.Damage)
                    {
                        <span class="bp-row-dmg">@share.ToString("0.0", CultureInfo.InvariantCulture)%</span>
                        <span class="bp-row-dps">@player.TotalDamageFormatted</span>
                    }
                    else
                    {
                        @if (!Options.HideTotalDamage)
                        {
                            <span class="bp-row-dmg">@player.TotalDamageFormatted (@share.ToString("0.0", CultureInfo.InvariantCulture)%)</span>
                        }
                        <span class="bp-row-dps">@DpsOf(player)<small>/s</small></span>
                    }
                </div>
            }
            }
        </div>
        @if (!Compact && (Chips.Count > 0 || Energy is not null))
        {
            <div class="bp-footer">
                <div class="bp-footer-line">
                    <span class="bp-events">
                        @foreach (var chip in Chips)
                        {
                            <span class="bp-ev bp-ev--@chip.State.ToString().ToLowerInvariant()" style="--ev:@EventIcons.Color(chip.Icon)" title="@chip.Tooltip">
                                @((MarkupString)EventIcons.Svg(chip.Icon))
                                @if (chip.State != AionDpsMeter.Timers.Overlay.ChipState.Idle)
                                {
                                    <span class="bp-ev-name">@EventIcons.ShortName(chip.Icon, chip.Name)</span>
                                }
                                @if (chip.Text.Length > 0)
                                {
                                    <b>@chip.Text</b>
                                }
                            </span>
                        }
                    </span>
                    @if (Energy is { } en)
                    {
                        <span class="bp-energy @(en.FromEarlierSession ? "bp-energy--old" : "")"
                              title="@(en.FromEarlierSession ? $"Последнее известное значение ({en.At.ToLocalTime():HH:mm}); игра пришлёт новое при пополнении" : "Энергия")">
                            ⚡ @en.Reading.Current<span class="bp-energy-extra">(+@en.Reading.Extra)</span>
                        </span>
                    }
                </div>
            </div>
        }
    </div>
}
