@* aion2-overlay fork: new file (see FORK_CHANGES.md). The 👤 window: the played character with its equipment and arcana
   (item level, enchant, tier) as the game sends them at login; the last login is kept, so it is never empty. *@
@using System.Globalization
@using AionDpsMeter.Timers.Character
@using AionDpsMeter.UI.Services.TimerWindow
@implements IDisposable
@inject CharacterTracker Character
@inject CharacterWindow Window
@inject AionDpsMeter.Services.Services.Entity.EntityTracker Entities

@{
    var eq = Character.Equipment;
    var items = eq?.Items.Select(i => (Worn: i, Info: ItemCatalog.Find(i.ItemId))).ToList() ?? [];
    var gear = items.Where(x => x.Worn.Slot < EquipmentParser.ArcanaSlotStart && x.Info?.Slot != "Arcana").ToList();
    var arcana = items.Where(x => x.Worn.Slot >= EquipmentParser.ArcanaSlotStart || x.Info?.Slot == "Arcana").ToList();
    var avg = gear.Where(x => x.Info is not null).Select(x => (double)x.Info!.ItemLevel).DefaultIfEmpty(0).Average();
    var me = Entities.PlayerEntities.FirstOrDefault(p => p.IsUser);
    var who = Character.Profile;
    var classId = me?.CharacterClass?.Id ?? who?.ClassId ?? 0;
    var name = me?.Name is { Length: > 0 } n0 ? n0 : who?.Name;
    var level = me?.CharacterLevel > 0 ? me.CharacterLevel : who?.Level ?? 0;
    var server = me?.ServerName is { Length: > 0 } s0 ? s0 : who?.Server;
    var power = me?.CombatPower > 0 ? me.CombatPower : who?.CombatPower ?? 0;
    var gs = me?.GearScore > 0 ? me.GearScore : who?.GearScore ?? 0;
}
<div class="ch">
    <div class="ch-title" @onmousedown="Window.Drag">
        <b>Персонаж</b>
        <span class="ch-grow"></span>
        <button type="button" class="ch-x" @onmousedown:stopPropagation="true" @onclick="Window.Close">✕</button>
    </div>
    <div class="ch-body">
        <div class="ch-hero">
            <span class="ch-class @(classId == 0 ? "none" : "")" style="@(classId == 0 ? "" : $"background-image:url('/images/classes/{classId}.png')")">@(classId == 0 ? "?" : "")</span>
            <div class="ch-who">
                <b>@(name ?? "Ваш персонаж")</b>
                <small>@(classId == 0 ? "класс и имя появятся после первого боя или входа" : ClassName(classId))@(level > 0 ? $" · уровень {level}" : "")@(server is { Length: > 0 } ? $" · {server}" : "")</small>
            </div>
            <span class="ch-grow"></span>
            <div class="ch-stat"><b class="gold">@(avg > 0 ? avg.ToString("0.0", CultureInfo.InvariantCulture) : "—")</b><small>ср. уровень предметов</small></div>
            <div class="ch-stat"><b>@gear.Count</b><small>предметов</small></div>
            @if (power > 0) { <div class="ch-stat"><b>@power.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"))</b><small>боевая мощь</small></div> }
            @if (gs > 0) { <div class="ch-stat"><b>@gs.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"))</b><small>ГС</small></div> }
        </div>

        <div class="ch-tabs">
            <button type="button" class="@(tab == "gear" ? "on" : "")" @onclick='() => tab = "gear"'>Экипировка <small>@gear.Count</small></button>
            <button type="button" class="@(tab == "arcana" ? "on" : "")" @onclick='() => tab = "arcana"'>Арканы <small>@arcana.Count</small></button>
            <span class="ch-grow"></span>
            @if (eq is { } e) { <small class="ch-when">по входу @e.At.ToString("dd.MM HH:mm")</small> }
        </div>

        @if (items.Count == 0)
        {
            <div class="ch-empty">Экипировку игра присылает при входе персонажа в игру. Перезайдите на персонажа — метр запомнит её, и окно больше не будет пустым.</div>
        }
        else if (tab == "gear")
        {
            <div class="ch-grid">
                <div class="ch-col">
                    @foreach (var x in gear.Where(x => IsArmor(x.Info?.Slot)).OrderBy(x => Order(x.Info?.Slot)).ThenBy(x => x.Worn.Slot))
                    {
                        @Card(x.Worn, x.Info)
                    }
                </div>
                <div class="ch-center">
                    <div class="ch-ring">
                        <span class="ch-class big @(classId == 0 ? "none" : "")" style="@(classId == 0 ? "" : $"background-image:url('/images/classes/{classId}.png')")">@(classId == 0 ? "?" : "")</span>
                        @if (classId != 0) { <em class="ch-ring-class">@ClassName(classId)</em> }
                        <b>@(avg > 0 ? avg.ToString("0.0", CultureInfo.InvariantCulture) : "—")</b>
                        <small>средний уровень предметов</small>
                    </div>
                </div>
                <div class="ch-col">
                    @foreach (var x in gear.Where(x => !IsArmor(x.Info?.Slot)).OrderBy(x => Order(x.Info?.Slot)).ThenBy(x => x.Worn.Slot))
                    {
                        @Card(x.Worn, x.Info)
                    }
                </div>
            </div>
        }
        else
        {
            <div class="ch-arcana">
                @foreach (var x in arcana.OrderBy(x => x.Worn.Slot))
                {
                    @Card(x.Worn, x.Info)
                }
                @if (arcana.Count == 0) { <div class="ch-empty">Арканы не надеты или игра их не прислала.</div> }
            </div>
        }
        <p class="ch-note">Названия и уровни предметов — из открытой таблицы SkeeveAN/Aion-DPS-Meter (MIT), иконки — с сайта NCSOFT.</p>
    </div>
</div>

@code {
    private string tab = "gear";

    private static readonly string[] Armor = ["MainHand", "SubHand", "Helmet", "Shoulder", "Torso", "Pants", "Gloves", "Boots", "Cape", "Belt"];
    private static readonly string[] SlotOrder = ["MainHand", "SubHand", "Helmet", "Shoulder", "Torso", "Pants", "Gloves", "Boots", "Cape", "Belt",
        "Necklace", "Earring", "Ring", "Bracelet", "Amulet", "Brooch", "Pendant", "Rune"];

    private static bool IsArmor(string? slot) => slot is not null && Armor.Contains(slot);
    private static int Order(string? slot) => slot is null ? 99 : Array.IndexOf(SlotOrder, slot) is var i and >= 0 ? i : 98;

    private static string SlotName(string? slot) => slot switch
    {
        "MainHand" => "Оружие", "SubHand" => "Вторая рука", "Helmet" => "Шлем", "Shoulder" => "Наплечники", "Torso" => "Нагрудник",
        "Pants" => "Поножи", "Gloves" => "Перчатки", "Boots" => "Ботинки", "Cape" => "Плащ", "Belt" => "Пояс",
        "Necklace" => "Ожерелье", "Earring" => "Серьга", "Ring" => "Кольцо", "Bracelet" => "Браслет", "Amulet" => "Амулет",
        "Brooch" => "Брошь", "Pendant" => "Подвеска", "Rune" => "Руна", "Arcana" => "Аркана",
        _ => slot ?? "Предмет",
    };

    private static string ClassName(long? id) => id switch
    {
        11 => "Гладиатор", 12 => "Страж", 13 => "Убийца", 14 => "Стрелок", 15 => "Волшебник",
        16 => "Заклинатель", 17 => "Целитель", 18 => "Чародей", 19 => "Мастер кулака", _ => "Класс неизвестен",
    };

    private int? openSlot;

    private void Toggle(int slot) => openSlot = openSlot == slot ? null : slot;

    private static string TierName(int tier) => tier switch { 1 => "белый", 2 => "зелёный", 3 => "синий", 4 => "золотой", _ => "" };

    private static string SkillName(int skill) =>
        AionDpsMeter.Core.GameData.Services.GameDataProvider.Instance.GetSkillOrDefault(skill).Name is { Length: > 0 } n ? n : $"Умение {skill}";

    private RenderFragment Card(WornItem w, ItemInfo? info) => __builder =>
    {
        var open = openSlot == w.Slot;
        var stones = w.Stones ?? [];
        <div class="ch-card @(open ? "open" : "")">
            <div class="ch-item g@(info?.Grade ?? 0)" title="Нажмите, чтобы увидеть статы, камни и божественный камень" @onclick="() => Toggle(w.Slot)">
                <span class="ch-icon">
                    @if (info?.IconUrl is { } url) { <img src="@url" alt="" /> }
                    @if (w.Enchant > 0) { <em>+@w.Enchant</em> }
                </span>
                <span class="ch-item-text">
                    <b>@(info?.Name ?? $"Предмет {w.ItemId}")</b>
                    <small>@SlotName(info?.Slot)@(info is { ItemLevel: > 0 } ? $" · IL {info.ItemLevel}" : "")</small>
                    <span class="ch-tags">
                        @if (info is { Tier: > 0 }) { <i>Тир @info.Tier</i> }
                        @foreach (var st in stones) { <u class="ch-dot t@(st.Tier)" title="@(st.Stat == 0 ? "пустой слот" : ItemStats.Name(st.Stat))"></u> }
                        @if (w.Godstone != 0) { <u class="ch-god" title="@(ItemStats.Godstone(w.Godstone) ?? "божественный камень")">✦</u> }
                    </span>
                </span>
                <span class="ch-more">@(open ? "▴" : "▾")</span>
            </div>
            @if (open)
            {
                var baseStats = ItemStats.Base(w.ItemId);
                <div class="ch-details">
                    @if (w.Arcana is { } a)
                    {
                        <h5>Аркана</h5>
                        <div class="ch-row"><span>Владыка: @ItemStats.Lord(a.GodStat)</span><b>+@a.GodValue</b></div>
                        <div class="ch-row"><span>Опыт</span><b>@a.Experience.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"))</b></div>
                        @foreach (var sk in a.Skills) { <div class="ch-row"><span>@SkillName(sk.Skill)</span><b>+@sk.Level ур.</b></div> }
                    }
                    @if (baseStats.Count > 0)
                    {
                        <h5>Свойства</h5>
                        @foreach (var (name, value) in baseStats) { <div class="ch-row"><span>@name</span><b>@value.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"))</b></div> }
                    }
                    @if (w.Stats is { Count: > 0 } rolled)
                    {
                        <h5>Дополнительные статы</h5>
                        @foreach (var st in rolled.Where(r => r.Value != 0)) { <div class="ch-row"><span>@ItemStats.Name(st.Stat)</span><b class="up">+@ItemStats.Value(st.Stat, st.Value)</b></div> }
                    }
                    @if (stones.Count > 0)
                    {
                        <h5>Камни маны</h5>
                        @foreach (var st in stones)
                        {
                            <div class="ch-row"><span><u class="ch-dot t@(st.Tier)"></u>@(st.Stat == 0 ? "пустой слот" : ItemStats.Name(st.Stat))</span><small>@TierName(st.Tier)</small></div>
                        }
                    }
                    @if (ItemStats.Godstone(w.Godstone) is { } god)
                    {
                        <h5>Божественный камень</h5>
                        <div class="ch-row"><span class="ch-godname">✦ @god</span></div>
                    }
                    @if (w.Arcana is null && baseStats.Count == 0 && w.Stats is null && stones.Count == 0)
                    {
                        <div class="ch-row"><span class="ch-muted">Статы и камни придут при следующем входе персонажа в игру (метр читает их из пакета входа).</span></div>
                    }
                </div>
            }
        </div>
    };

    private Timer? timer;

    protected override void OnInitialized()
    {
        Character.Changed += OnChanged;
        Remember();
        // the entity marked as me comes with the first fight or login after the window opened
        timer = new Timer(_ => { if (Remember()) OnChanged(); }, null, 2000, 2000);
    }

    /// <summary>Keeps who the character is, so a restart still shows the name and class.</summary>
    private bool Remember()
    {
        if (Entities.PlayerEntities.FirstOrDefault(p => p.IsUser) is not { Name.Length: > 0 } me) return false;
        var profile = new AionDpsMeter.Timers.Character.CharacterProfile(me.Name, me.CharacterClass?.Id ?? 0, me.CharacterLevel,
            me.ServerName is { Length: > 0 } s ? s : null, me.CombatPower, me.GearScore);
        if (Character.Profile == profile) return false;
        Character.RememberProfile(profile);
        return true;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Character.Changed -= OnChanged;
        timer?.Dispose();
    }
}
