@* aion2-overlay fork: new file (see FORK_CHANGES.md). The damage tab's views in their own windows, laid out like the
   reference meter: "Хронология умений" (skills on a time chart with the boss's HP), "Хронология баффов" (a Gantt with
   filters) and "Баффы по умениям" (which buffs were on for each skill's casts). *@
@using System.Globalization
@using AionDpsMeter.Core.Models
@using AionDpsMeter.Services.Models
@using AionDpsMeter.Services.Services.Session
@using AionDpsMeter.Timers.Modes
@using AionDpsMeter.UI.Services.TimerWindow
@implements IDisposable
@inject AionDpsMeter.Services.Services.Session.Persistence.ICombatHistoryStore Store
@inject CombatSessionManager Sessions
@inject HistoryViewWindow Window
@inject AionDpsMeter.Timers.Replay.PositionLog Positions
@inject AionDpsMeter.Timers.Feed.TimersOptionsStore TimerOptions
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="hv" @onmousemove="DragMove" @onmouseup="DragEnd" @onmouseleave="DragEnd">
    <div class="hv-title" @onmousedown="() => Window.Drag(View)">
        <b>@HistoryViewWindow.Title(View)</b>
        @if (View == HistoryViewWindow.PerSkill && Build() is { } head)
        {
            <span class="hv-title-sub">· @head.Who.PlayerName <em>@Clock(head.End - head.Start)</em></span>
        }
        <span class="hv-grow"></span>
        <button type="button" class="hv-x" @onmousedown:stopPropagation="true" @onclick="() => Window.Close(View)">✕</button>
    </div>

    @if (Build() is not { } c)
    {
        <p class="hv-empty">Нет данных боя. Откройте вид из «Истории боёв» — вкладка «Урон».</p>
    }
    else if (View == HistoryViewWindow.Replay)
    {
        @Replay(c)
    }
    else if (View == HistoryViewWindow.PerSkill)
    {
        var mine = c.S.BuffEventsByPlayer.TryGetValue(c.Who.PlayerId, out var onMe) ? onMe.Where(Shown).ToList() : [];
        var onBoss = c.S.BuffEventsByPlayer.TryGetValue(c.S.TargetId, out var tb) ? tb.Where(Shown).ToList() : [];
        var buffSpans = Spans(c, mine);
        var debuffSpans = Spans(c, onBoss);
        var allCasts = c.Runs.Select(r => r.At).ToList();
        <div class="hv-body">
            <div class="hv-box hv-ps-head">
                <span class="hv-cls" style="background-image:url('/images/classes/@(c.Who.ClassId).png')"></span>
                <b>@c.Who.PlayerName</b>
                <b class="teal">@Fmt(c.Who.TotalDamage)</b>
                <span class="mute">@c.Runs.Count @Casts(c.Runs.Count)</span>
                @if (c.Who.CombatPower > 0) { <span class="mute">БС @c.Who.CombatPower.ToString("N0", Ru)</span> }
                <span class="hv-sep"></span>
                <span>@Target(c.S)</span>
                <span class="hv-grow"></span>
                <span class="hv-flabel">ПОКАЗАТЬ</span>
                <button type="button" class="hv-tog @(showOwn ? "on" : "")" @onclick="() => showOwn = !showOwn"><i></i>Свои</button>
                <button type="button" class="hv-tog @(showGroup ? "on" : "")" @onclick="() => showGroup = !showGroup"><i></i>Группа</button>
                <button type="button" class="hv-tog @(showOthers ? "on" : "")" @onclick="() => showOthers = !showOthers"><i></i>Другие</button>
            </div>

            <div class="hv-box">
                <div class="hv-cap">ВСЕ УМЕНИЯ <span>Доля из @c.Runs.Count @Casts(c.Runs.Count), во время которых действовал каждый бафф</span></div>
                <div class="hv-strip">
                    @foreach (var b in buffSpans.Select(b => (b.Name, b.Icon, Share: Timeline.ActiveShare(allCasts, b.Spans))).Where(b => b.Share > 0).OrderByDescending(b => b.Share))
                    {
                        <div class="hv-strip-item" title="@b.Name">
                            <span class="hv-big-ico">@if (!string.IsNullOrEmpty(b.Icon)) { <img src="@b.Icon" alt="" /> }</span>
                            <b>@Pc(b.Share)</b>
                            <small>@b.Name</small>
                        </div>
                    }
                    @if (buffSpans.Count == 0) { <span class="mute">Баффов в этом бою не сохранено.</span> }
                </div>
            </div>

            <div class="hv-cards">
                @foreach (var k in c.SkillStats.OrderByDescending(k => k.TotalDamage))
                {
                    var times = c.Runs.Where(r => r.Skill == k.SkillId).Select(r => r.At).ToList();
                    if (times.Count == 0) continue;
                    var bs = buffSpans.Select(b => (b.Name, b.Icon, b.Caster, Share: Timeline.ActiveShare(times, b.Spans))).Where(b => b.Share > 0).OrderByDescending(b => b.Share).ToList();
                    var always = bs.Where(b => b.Share >= 0.999).ToList();
                    var top = bs.Where(b => b.Share < 0.999).ToList();
                    var debuffs = debuffSpans.Select(b => (b.Name, b.Icon, b.Caster, Share: Timeline.ActiveShare(times, b.Spans))).Where(b => b.Share > 0).OrderByDescending(b => b.Share).ToList();
                    var open = expanded.Contains(k.SkillId);
                    var more = Math.Max(0, top.Count - 3) + Math.Max(0, debuffs.Count - 3);
                    var skillId = k.SkillId;
                    <div class="hv-card">
                        <div class="hv-card-head">
                            <span class="hv-big-ico">@if (!string.IsNullOrEmpty(k.SkillIcon)) { <img src="@k.SkillIcon" alt="" /> }</span>
                            <span class="hv-card-name"><b>@k.SkillName</b><small>@times.Count @Casts(times.Count) · @Fmt(k.TotalDamage)</small></span>
                            <span class="hv-card-pct"><b>@P(k.DamagePercentage)</b><small>УРОНА</small></span>
                        </div>
                        <div class="hv-always">
                            <span class="hv-cap2">ВСЕГДА АКТИВЕН</span>
                            <span class="hv-always-icons">
                                @foreach (var b in always)
                                {
                                    <span class="hv-mini" title="@b.Name">@if (!string.IsNullOrEmpty(b.Icon)) { <img src="@b.Icon" alt="" /> }</span>
                                }
                                @if (always.Count == 0) { <span class="mute">—</span> }
                            </span>
                        </div>
                        <div class="hv-cap2">ТОП 3 ПО ВРЕМЕНИ ДЕЙСТВИЯ БАФФОВ <span>всего @top.Count</span></div>
                        @foreach (var b in open ? top : top.Take(3))
                        {
                            <div class="hv-brow">
                                <span class="hv-mini">@if (!string.IsNullOrEmpty(b.Icon)) { <img src="@b.Icon" alt="" /> }</span>
                                <span class="hv-brow-name"><span>@b.Name</span><small>@b.Caster</small></span>
                                <span class="hv-seg">@for (var i = 0; i < 24; i++) { <i class="@(i < Math.Round(b.Share * 24) ? "on" : "")"></i> }</span>
                                <b>@Pc(b.Share)</b>
                            </div>
                        }
                        @if (top.Count == 0) { <div class="mute hv-none">—</div> }
                        <div class="hv-cap2">ТОП 3 ПО ВРЕМЕНИ ДЕЙСТВИЯ ДЕБАФФОВ ЦЕЛИ <span>всего @debuffs.Count</span></div>
                        @foreach (var b in open ? debuffs : debuffs.Take(3))
                        {
                            <div class="hv-brow">
                                <span class="hv-mini">@if (!string.IsNullOrEmpty(b.Icon)) { <img src="@b.Icon" alt="" /> }</span>
                                <span class="hv-brow-name"><span>@b.Name</span><small>@b.Caster</small></span>
                                <span class="hv-seg">@for (var i = 0; i < 24; i++) { <i class="@(i < Math.Round(b.Share * 24) ? "on" : "")"></i> }</span>
                                <b>@Pc(b.Share)</b>
                            </div>
                        }
                        @if (debuffs.Count == 0) { <div class="mute hv-none">—</div> }
                        @if (more > 0 || open)
                        {
                            <button type="button" class="hv-more" @onclick="() => Toggle(expanded, skillId)">@(open ? "свернуть ⌃" : $"+{more} ещё ⌄")</button>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        var vs = zFrom / 1000.0 * c.Dur;
        var ve = Math.Max(vs + 0.5, zTo / 1000.0 * c.Dur);
        <div class="hv-body">
            <div class="hv-who">
                <b class="hv-boss">@Target(c.S)</b><span class="hv-bar"></span>
                <b>@c.Who.PlayerName</b>
                <span class="hv-badge">@ClassName(c.Who)</span>
                <span class="teal">@(c.Dur.ToString("0", CultureInfo.InvariantCulture))s</span>
            </div>
            <div class="hv-box hv-opening">
                <span class="hv-flabel">ОТКРЫТИЕ</span>
                <span class="hv-open-row">
                    @foreach (var r in c.Runs.Take(28))
                    {
                        var sk = c.Skills.GetValueOrDefault(r.Skill);
                        <span class="hv-oi" title="@sk?.Name · +@Sec(r.At - c.Start)">@if (!string.IsNullOrEmpty(sk?.Icon)) { <img src="@sk.Icon" alt="" /> } else { <i>?</i> }</span>
                    }
                </span>
            </div>

            @if (View == HistoryViewWindow.Rotation)
            {
                var lanes = c.Runs.GroupBy(r => r.Skill)
                    .Select(g => (Skill: g.Key, Dmg: c.Hits.Where(h => h.Skill.Id == g.Key).Sum(h => h.Damage)))
                    .OrderByDescending(x => x.Dmg).Select(x => x.Skill).Take(22).ToList();
                var laneH = (ChartH - 20) / Math.Max(1, lanes.Count);
                var hp = BossHp(c);
                <div class="hv-box hv-filters">
                    <div class="hv-frow">
                        <span class="hv-flabel">УМЕНИЯ</span>
                        <span class="hv-chips">
                            <button type="button" class="hv-chip" @onclick="() => { pickedSkills.Clear(); pickedRun = null; }">Снять выделение</button>
                            @foreach (var id in lanes)
                            {
                                var sk = c.Skills.GetValueOrDefault(id);
                                var skillId = id;
                                <button type="button" class="hv-chip @(pickedSkills.Contains(id) ? "on" : "")" @onclick="() => Toggle(pickedSkills, skillId)">@if (!string.IsNullOrEmpty(sk?.Icon)) { <img src="@sk.Icon" alt="" /> }@sk?.Name</button>
                            }
                        </span>
                    </div>
                    <div class="hv-frow">
                        <span class="hv-flabel">ЦЕЛИ</span>
                        <span class="hv-chips"><span class="hv-chip on"><i class="dot" style="background:#e0609c"></i>@Target(c.S)</span></span>
                    </div>
                </div>
                <div class="hv-chart" style="height:@(F(ChartH))px">
                    @for (var i = 0; i <= 5; i++)
                    {
                        var y = 10 + i * (ChartH - 20) / 5.0;
                        <i class="hv-hline" style="top:@(F(y))px"></i>
                        if (i < 5)
                        {
                            <span class="hv-ylab" style="top:@(F(y))px">@(100 - i * 20)%</span>
                        }
                    }
                    <div class="hv-plot" @ref="plotRef" @onwheel="e => Wheel(e, plotRef)" @onwheel:preventDefault="true" @onmousedown="e => DragStart(e, plotRef, false)">
                    @foreach (var t in Ticks(vs, ve))
                    {
                        <i class="hv-vline" style="left:@Ps((t - vs) / (ve - vs) * 100)"></i>
                    }
                    @if (hp.Count > 1)
                    {
                        <svg class="hv-hp" viewBox="0 0 1000 100" preserveAspectRatio="none">
                            <polyline points="@string.Join(" ", hp.Select(p => F((p.Sec - vs) / (ve - vs) * 1000) + "," + F((1 - p.Hp) * 100)))" />
                        </svg>
                    }
                    @for (var li = 0; li < lanes.Count; li++)
                    {
                        var id = lanes[li];
                        var sk = c.Skills.GetValueOrDefault(id);
                        var y = 10 + (li + 0.5) * laneH;
                        var dim = pickedSkills.Count > 0 && !pickedSkills.Contains(id);
                        foreach (var r in c.Runs.Where(r => r.Skill == id))
                        {
                            var x = ((r.At - c.Start).TotalSeconds - vs) / (ve - vs) * 100;
                            if (x < -2 || x > 102) continue;
                            var run = r;
                            if (r.Hits >= 4 && (r.End - r.At).TotalSeconds >= 1)
                            {
                                var x2 = ((r.End - c.Start).TotalSeconds - vs) / (ve - vs) * 100;
                                <i class="hv-channel @(dim ? "dim" : "")" style="left:@Ps(x);width:@Ps(Math.Max(0.3, x2 - x));top:@(F(y - 6))px"></i>
                            }
                            <span class="hv-ico @(dim ? "dim" : "") @(pickedRun == run ? "on" : "")" style="left:@Ps(x);top:@(F(y))px" title="@sk?.Name · +@Sec(r.At - c.Start)" @onclick="() => { if (!moved) pickedRun = run; }">
                                @if (!string.IsNullOrEmpty(sk?.Icon)) { <img src="@sk.Icon" alt="" /> } else { <i></i> }
                            </span>
                        }
                    }
                    </div>
                </div>
                @Axis(vs, ve)
                @Scrubber(c)
                @Zoom()
                <div class="hv-box hv-detail">
                    @if (pickedRun is { } pr && c.Skills.GetValueOrDefault(pr.Skill) is { } ps)
                    {
                        var rh = c.Hits.Where(h => h.Skill.Id == pr.Skill && h.DateTime >= pr.At && h.DateTime <= pr.End).ToList();
                        var st = c.SkillStats.FirstOrDefault(k => k.SkillId == pr.Skill);
                        <span class="hv-big-ico">@if (!string.IsNullOrEmpty(ps.Icon)) { <img src="@ps.Icon" alt="" /> }</span>
                        <span class="hv-detail-name"><b>@ps.Name</b><small>+@Sec(pr.At - c.Start) от начала боя@(pr.End > pr.At ? $" · длилось {Sec(pr.End - pr.At)}" : "")</small></span>
                        <span class="hv-kv"><small>Урон</small><b>@Fmt(rh.Sum(h => h.Damage))</b></span>
                        <span class="hv-kv"><small>Попаданий</small><b>@rh.Count</b></span>
                        <span class="hv-kv"><small>Крит</small><b>@rh.Count(h => h.IsCritical)</b></span>
                        <span class="hv-kv"><small>Спина</small><b>@rh.Count(h => h.IsBackAttack)</b></span>
                        <span class="hv-kv"><small>Идеал.</small><b>@rh.Count(h => h.IsPerfect)</b></span>
                        <span class="hv-kv"><small>Макс</small><b>@Fmt(rh.Count > 0 ? rh.Max(h => h.Damage) : 0)</b></span>
                        @if (st is not null)
                        {
                            <span class="hv-kv"><small>За бой</small><b>@Fmt(st.TotalDamage) · @P(st.DamagePercentage)</b></span>
                            <span class="hv-kv"><small>Применений</small><b>@c.Runs.Count(r => r.Skill == pr.Skill)</b></span>
                        }
                    }
                    else
                    {
                        <span class="hv-hint">Нажмите на умение в графике, чтобы увидеть детали</span>
                    }
                </div>
            }
            else
            {
                var events = BuffEvents(c);
                var targets = events.Select(e => e.EntityId).Distinct().ToList();
                var sources = events.Select(e => e.CasterId).Distinct().ToList();
                var shown = events.Where(e => !hiddenTargets.Contains(e.EntityId) && !hiddenSources.Contains(e.CasterId)).ToList();
                var rows = shown.GroupBy(e => e.BuffName)
                    .Select(g => (Name: g.Key, Icon: g.First().BuffIcon, Color: Color(g.Key),
                        Bars: g.Select(e => Clip(c, e)).Where(b => b.To > b.From).OrderBy(b => b.From).ToList(),
                        Up: Timeline.Uptime(Timeline.Merge(g.Select(e => (e.AppliedAt, e.AppliedAt.AddMilliseconds(e.DurationMs))), c.Start, c.End), c.Start, c.End)))
                    .Where(r => r.Up > 0).OrderByDescending(r => r.Up).ThenBy(r => r.Name).ToList();
                <div class="hv-box hv-filters">
                    <div class="hv-frow">
                        <span class="hv-flabel">НАПРАВЛЕНИЕ</span>
                        <span class="hv-chips">
                            <button type="button" class="hv-chip dotted @(dirMine ? "on" : "")" @onclick="() => dirMine = !dirMine"><i class="dot"></i>Баффы, которые я наложил</button>
                            <button type="button" class="hv-chip dotted @(dirOnMe ? "on" : "")" @onclick="() => dirOnMe = !dirOnMe"><i class="dot"></i>Баффы на мне</button>
                        </span>
                    </div>
                    <div class="hv-frow">
                        <span class="hv-flabel">УМЕНИЯ</span>
                        <span class="hv-chips">
                            <button type="button" class="hv-chip" @onclick="() => pickedBuffs.Clear()">Снять выделение</button>
                            @foreach (var r in rows)
                            {
                                var name = r.Name;
                                <button type="button" class="hv-chip @(pickedBuffs.Contains(name) ? "on" : "")" @onclick="() => Toggle(pickedBuffs, name)"><i class="sq" style="background:@r.Color"></i>@if (!string.IsNullOrEmpty(r.Icon)) { <img src="@r.Icon" alt="" /> }@r.Name <em>@Pc(r.Up)</em></button>
                            }
                        </span>
                    </div>
                    <div class="hv-frow">
                        <span class="hv-flabel">ЦЕЛИ</span>
                        <span class="hv-chips">
                            @foreach (var id in targets)
                            {
                                var e = id;
                                <button type="button" class="hv-chip dotted @(hiddenTargets.Contains(e) ? "" : "on")" @onclick="() => Toggle(hiddenTargets, e)"><i class="dot" style="background:@(e == c.S.TargetId ? "#e0609c" : "#5fd49a")"></i>@Who(c, e)</button>
                            }
                        </span>
                    </div>
                    <div class="hv-frow">
                        <span class="hv-flabel">ИСТОЧНИКИ</span>
                        <span class="hv-chips">
                            @foreach (var id in sources)
                            {
                                var e = id;
                                <button type="button" class="hv-chip dotted @(hiddenSources.Contains(e) ? "" : "on")" @onclick="() => Toggle(hiddenSources, e)"><i class="dot" style="background:@(e == (int)c.Who.PlayerId ? "#5fd4c4" : "#a3d977")"></i>@Who(c, e)</button>
                            }
                        </span>
                    </div>
                </div>
                @if (rows.Count == 0)
                {
                    <p class="hv-empty">Баффов по этим фильтрам нет.</p>
                }
                <div class="hv-gantt" @ref="ganttRef" @onwheel="e => Wheel(e, ganttRef, GanttLabel)" @onwheel:preventDefault="true" @onmousedown="e => DragStart(e, ganttRef, false, GanttLabel)">
                    @foreach (var r in rows)
                    {
                        var dim = pickedBuffs.Count > 0 && !pickedBuffs.Contains(r.Name);
                        <div class="hv-grow-row @(dim ? "dim" : "")">
                            <span class="hv-glabel">@r.Name (@Pc(r.Up))</span>
                            <span class="hv-gtrack">
                                @foreach (var t in Ticks(vs, ve))
                                {
                                    <i class="hv-vline" style="left:@Ps((t - vs) / (ve - vs) * 100)"></i>
                                }
                                @foreach (var b in r.Bars)
                                {
                                    var x1 = Math.Max(0, (b.From - vs) / (ve - vs) * 100);
                                    var x2 = Math.Min(100, (b.To - vs) / (ve - vs) * 100);
                                    if (x2 <= x1) continue;
                                    <i class="hv-gbar" style="left:@Ps(x1);width:@Ps(x2 - x1);background:@(r.Color)99;border-color:@r.Color"></i>
                                }
                            </span>
                        </div>
                    }
                </div>
                <div class="hv-gantt-axis">@Axis(vs, ve)</div>
                <div class="hv-gantt-axis">@Scrubber(c)</div>
                <div class="hv-gantt-axis">@Zoom()</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string View { get; set; } = HistoryViewWindow.Rotation;

    private const double ChartH = 420;
    private static readonly CultureInfo Ru = CultureInfo.GetCultureInfo("ru-RU");

    private static readonly Dictionary<int, string> Classes = new()
    {
        [11] = "Гладиатор", [12] = "Страж", [13] = "Убийца", [14] = "Стрелок", [15] = "Волшебник",
        [16] = "Заклинатель", [17] = "Целитель", [18] = "Чародей", [19] = "Мастер кулака",
    };

    /// <summary>Buff colours in the reference's muted range: green, teal, orange, cyan, red, olive, blue, brown, violet.</summary>
    private static readonly string[] Palette = ["#86b45f", "#4fb6ae", "#d68a4c", "#6fd0d6", "#c9675b", "#a3b85a", "#5f9ed8", "#b88a5c", "#9a7fd0"];

    private HistorySessionSnapshot? snap;
    private Guid? session;
    private long playerId;
    private System.Threading.Timer? tick;

    private int zFrom, zTo = 1000;
    private readonly HashSet<int> pickedSkills = [];
    private (DateTime At, DateTime End, int Skill, int Hits)? pickedRun;
    private bool dirMine = true, dirOnMe = true;
    private readonly HashSet<string> pickedBuffs = [];
    private readonly HashSet<int> hiddenTargets = [], hiddenSources = [];
    private bool showOwn = true, showGroup = true, showOthers = true;
    private readonly HashSet<long> expanded = [];

    private sealed record Ctx(HistorySessionSnapshot S, PlayerStats Who, DateTime Start, DateTime End, IReadOnlyList<PlayerDamage> Hits,
        Dictionary<int, Skill> Skills, IReadOnlyList<(DateTime At, DateTime End, int Skill, int Hits)> Runs, IReadOnlyCollection<SkillStats> SkillStats)
    {
        public double Dur => Math.Max(0.5, (End - Start).TotalSeconds);
    }

    private Ctx? built;
    private (HistorySessionSnapshot? Snap, long Player) builtFor;

    private Ctx? Build()
    {
        if (snap is not { } s || s.PlayerStats.Count == 0) return null;
        if (built is not null && ReferenceEquals(builtFor.Snap, s) && builtFor.Player == playerId) return built;
        var who = s.PlayerStats.FirstOrDefault(p => p.PlayerId == playerId) ?? s.PlayerStats.FirstOrDefault(p => p.IsUser) ?? s.PlayerStats.OrderByDescending(p => p.TotalDamage).First();
        var hits = (s.HitsByPlayer.TryGetValue(who.PlayerId, out var h) ? h : []).Where(x => x.Skill is not null).OrderBy(x => x.DateTime).ToList();
        var start = s.SessionStart;
        var end = s.SessionEnd > start ? s.SessionEnd : start.AddSeconds(1);
        var skills = hits.GroupBy(x => x.Skill.Id).ToDictionary(g => g.Key, g => g.First().Skill);
        var runs = Timeline.Runs(hits.Select(x => (x.DateTime, x.Skill.Id)));
        var stats = s.SkillStatsByPlayer.TryGetValue(who.PlayerId, out var ks) ? ks : [];
        builtFor = (s, playerId);
        return built = new Ctx(s, who, start, end, hits, skills, runs, stats);
    }

    protected override void OnInitialized()
    {
        Load();
        Window.Requested += OnRequested;
        tick = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (session is null) { Load(); StateHasChanged(); }
        }), null, 1000, 1000);
    }

    private void OnRequested(string view)
    {
        if (view != View) return;
        InvokeAsync(() =>
        {
            zFrom = 0; zTo = 1000; pickedSkills.Clear(); pickedRun = null; pickedBuffs.Clear();
            hiddenTargets.Clear(); hiddenSources.Clear(); expanded.Clear();
            Load();
            StateHasChanged();
        });
    }

    private void Load()
    {
        (session, playerId) = Window.Request(View);
        try
        {
            snap = session is { } g ? Store.GetSession(g)
                : Sessions.GetActiveTargetSession() is { } live ? HistorySessionSnapshot.From(live) : snap;
        }
        catch (Exception) { }
    }

    /// <summary>"Баффы, которые я наложил" — on anyone; "Баффы на мне" — by anyone.</summary>
    private List<BuffEvent> BuffEvents(Ctx c)
    {
        var me = (int)c.Who.PlayerId;
        var set = new HashSet<BuffEvent>(ReferenceEqualityComparer.Instance);
        if (dirOnMe && c.S.BuffEventsByPlayer.TryGetValue(c.Who.PlayerId, out var onMe)) set.UnionWith(onMe);
        if (dirMine) set.UnionWith(c.S.BuffEventsByPlayer.Values.SelectMany(v => v).Where(e => e.CasterId == me));
        return set.ToList();
    }

    /// <summary>"Свои" — I cast it, "Группа" — another player of the fight did, "Другие" — anyone else.</summary>
    private bool Shown(BuffEvent e)
    {
        if (built is not { } c) return true;
        if (e.CasterId == (int)c.Who.PlayerId) return showOwn;
        return c.S.PlayerStats.Any(p => (int)p.PlayerId == e.CasterId) ? showGroup : showOthers;
    }

    private static List<(string Name, string? Icon, string Caster, IReadOnlyList<(DateTime From, DateTime To)> Spans)> Spans(Ctx c, IEnumerable<BuffEvent> events) =>
        events.GroupBy(e => e.BuffName)
            .Select(g => (Name: g.Key, Icon: g.First().BuffIcon,
                Caster: Who(c, g.GroupBy(e => e.CasterId).OrderByDescending(x => x.Count()).First().Key, self: false),
                Spans: Timeline.Merge(g.Select(e => (e.AppliedAt, e.AppliedAt.AddMilliseconds(e.DurationMs))), c.Start, c.End)))
            .ToList();

    private static (double From, double To) Clip(Ctx c, BuffEvent e) =>
        (Math.Max(0, (e.AppliedAt - c.Start).TotalSeconds), Math.Min(c.Dur, (e.AppliedAt.AddMilliseconds(e.DurationMs) - c.Start).TotalSeconds));

    private static string Who(Ctx c, int id, bool self = true)
    {
        if (id == (int)c.Who.PlayerId) return self ? "Себя" : c.Who.PlayerName;
        if (id == c.S.TargetId) return Target(c.S);
        return c.S.PlayerStats.FirstOrDefault(p => (int)p.PlayerId == id)?.PlayerName ?? $"Неизвестно #{id}";
    }

    /// <summary>The boss's HP over the fight from the group's damage: 100% at the start, falling with every hit.</summary>
    private static List<(double Sec, double Hp)> BossHp(Ctx c)
    {
        if (c.S.TargetHpTotal <= 0) return [];
        var points = new List<(double Sec, double Hp)> { (0, 1) };
        long sum = 0;
        foreach (var h in c.S.HitsByPlayer.Values.SelectMany(v => v).OrderBy(h => h.DateTime))
        {
            sum += h.Damage;
            points.Add(((h.DateTime - c.Start).TotalSeconds, Math.Max(0, 1 - (double)sum / c.S.TargetHpTotal)));
        }
        var every = points.Count / 500 + 1;
        return every == 1 ? points : points.Where((_, i) => i % every == 0).Append(points[^1]).ToList();
    }

    private static IEnumerable<double> Ticks(double from, double to)
    {
        var step = Timeline.AxisStep(to - from);
        for (var t = Math.Ceiling(from / step) * step; t < to - step * 0.35; t += step) yield return t;
    }

    private static RenderFragment Axis(double from, double to) => __builder =>
    {
        <div class="hv-axis">
            @foreach (var t in Ticks(from, to))
            {
                <span style="left:@Ps((t - from) / (to - from) * 100)">@Clock(TimeSpan.FromSeconds(t))</span>
            }
            <span style="left:100%">@Clock(TimeSpan.FromSeconds(to))</span>
        </div>
    };

    /// <summary>The zoom bar under the chart: the group's damage over the whole fight, two handles for the shown part.</summary>
    private RenderFragment Scrubber(Ctx c) => __builder =>
    {
        var bins = new double[120];
        foreach (var h in c.S.HitsByPlayer.Values.SelectMany(v => v))
        {
            var i = (int)Math.Clamp((h.DateTime - c.Start).TotalSeconds / c.Dur * bins.Length, 0, bins.Length - 1);
            bins[i] += h.Damage;
        }
        var max = Math.Max(1, bins.Max());
        var pts = string.Join(" ", bins.Select((v, i) => F(i * 1000.0 / (bins.Length - 1)) + "," + F(30 - v / max * 26)));
        <div class="hv-scrub" @ref="scrubRef" @onmousedown="e => DragStart(e, scrubRef, true)">
            <svg viewBox="0 0 1000 30" preserveAspectRatio="none"><polyline points="0,30 @pts 1000,30" /></svg>
            <i class="hv-scrub-win" style="left:@(F(zFrom / 10.0))%;width:@(F((zTo - zFrom) / 10.0))%"></i>
            <input type="range" min="0" max="1000" value="@zFrom" @oninput="SetFrom" @onmousedown:stopPropagation="true" />
            <input type="range" min="0" max="1000" value="@zTo" @oninput="SetTo" @onmousedown:stopPropagation="true" />
        </div>
    };

    private const double GanttLabel = 250;
    private ElementReference plotRef, ganttRef, scrubRef;
    private bool dragging, dragScrub, moved, skipRender;
    private double dragX, dragW;
    private int dragFrom, dragTo;

    protected override bool ShouldRender()
    {
        if (!skipRender) return true;
        skipRender = false;
        return false;
    }

    private async Task<(double Left, double Width)> Rect(ElementReference el, double pad)
    {
        try
        {
            var r = await JS.InvokeAsync<double[]>("forkRect", el);
            return (r[0] + pad, Math.Max(1, r[1] - pad));
        }
        catch (Exception) { return (0, 1000); }
    }

    /// <summary>The wheel zooms around the cursor; with Shift it moves along the fight.</summary>
    private async Task Wheel(WheelEventArgs e, ElementReference el, double pad = 0)
    {
        var span = zTo - zFrom;
        if (e.ShiftKey) { Pan(span * (e.DeltaY > 0 ? 0.15 : -0.15), zFrom, zTo); return; }
        var (left, width) = await Rect(el, pad);
        var a = Math.Clamp((e.ClientX - left) / width, 0, 1);
        var next = Math.Clamp(span * (e.DeltaY > 0 ? 1.25 : 0.8), 20, 1000);
        var from = Math.Clamp(zFrom + a * span - a * next, 0, 1000 - next);
        zFrom = (int)Math.Round(from);
        zTo = (int)Math.Min(1000, Math.Round(from + next));
    }

    private void Pan(double delta, int from, int to)
    {
        var span = to - from;
        zFrom = (int)Math.Round(Math.Clamp(from + delta, 0, 1000 - span));
        zTo = zFrom + span;
    }

    private async Task DragStart(MouseEventArgs e, ElementReference el, bool scrub, double pad = 0)
    {
        if (e.Button != 0) return;
        var (_, width) = await Rect(el, pad);
        dragging = true; dragScrub = scrub; moved = false;
        dragX = e.ClientX; dragW = width; dragFrom = zFrom; dragTo = zTo;
    }

    /// <summary>Dragging the chart moves along the fight; dragging the zoom bar moves its window.</summary>
    private void DragMove(MouseEventArgs e)
    {
        if (mapDragging)
        {
            var k = mapSpan / Math.Max(1, Math.Min(mapW, mapH));
            mapCx = mapDragCx - (e.ClientX - mapDragX) * k;
            mapCy = mapDragCy - (e.ClientY - mapDragY) * k;
            return;
        }
        if (!dragging) { skipRender = true; return; }
        var dx = e.ClientX - dragX;
        if (!moved && Math.Abs(dx) <= 3) { skipRender = true; return; }
        moved = true;
        Pan(dragScrub ? dx * 1000 / dragW : -dx * (dragTo - dragFrom) / dragW, dragFrom, dragTo);
    }

    private void DragEnd()
    {
        if (mapDragging) { mapDragging = false; return; }
        if (!dragging) { skipRender = true; return; }
        dragging = false;
    }

    private RenderFragment Zoom() => __builder =>
    {
        <div class="hv-zoom">
            <span>Колесо мыши — масштаб · зажать и тянуть — прокрутка · Shift + колесо — сдвиг</span>
            @if (zFrom > 0 || zTo < 1000)
            {
                <button type="button" @onclick="() => { zFrom = 0; zTo = 1000; }">Весь бой</button>
            }
        </div>
    };

    private void SetFrom(ChangeEventArgs e) => zFrom = Math.Clamp(int.TryParse(e.Value?.ToString(), out var v) ? v : 0, 0, zTo - 20);

    private void SetTo(ChangeEventArgs e) => zTo = Math.Clamp(int.TryParse(e.Value?.ToString(), out var v) ? v : 1000, zFrom + 20, 1000);

    private static void Toggle<T>(HashSet<T> set, T value)
    {
        if (!set.Remove(value)) set.Add(value);
    }

    private static string Color(string name)
    {
        var h = 0;
        foreach (var ch in name) h = unchecked(h * 31 + ch);
        return Palette[(int)((uint)h % Palette.Length)];
    }

    private static string ClassName(PlayerStats p) => Classes.GetValueOrDefault(p.ClassId) ?? p.ClassName;

    private static string Target(HistorySessionSnapshot s) => string.IsNullOrWhiteSpace(s.TargetName) ? "Цель" : s.TargetName;

    private static string Casts(int n) => (n % 10, n % 100) switch
    {
        (1, not 11) => "применение умений",
        (2 or 3 or 4, not (12 or 13 or 14)) => "применения умений",
        _ => "применений умений",
    };

    private static string Fmt(double v) => AionDpsMeter.UI.Utils.DamageFormatter.Format((long)v);
    private static string P(double v) => v.ToString("0.0", CultureInfo.InvariantCulture) + "%";
    private static string Pc(double share) => (share * 100).ToString("0", CultureInfo.InvariantCulture) + "%";
    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Ps(double v) => F(v) + "%";
    private static string Sec(TimeSpan t) => t.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) + "s";
    private static string Clock(TimeSpan t) => t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");


    // ---------- "Повтор боя": the group and the boss from above, as the game reported their places ----------
    private Dictionary<int, List<AionDpsMeter.Timers.Replay.Fix>>? tracks;
    private (HistorySessionSnapshot? Snap, Guid? Session) tracksFor;
    private double replayT;
    private bool playing;
    private double speed = 1;
    // the replay map: centre and size in map units (x right, y = -world y down), the element's size in pixels, follow and drag
    private double mapCx, mapCy, mapSpan, mapW = 900, mapH = 520;
    private bool follow = true, mapDragging;
    private double mapDragX, mapDragY, mapDragCx, mapDragCy;
    private ElementReference mapRef;
    private System.Threading.Timer? player;

    private Dictionary<int, List<AionDpsMeter.Timers.Replay.Fix>> Tracks(Ctx c)
    {
        if (tracks is not null && ReferenceEquals(tracksFor.Snap, c.S) && tracksFor.Session == session) return tracks;
        tracksFor = (c.S, session);
        var ids = c.S.PlayerStats.Select(p => (int)p.PlayerId).Append(c.S.TargetId).ToList();
        tracks = (session is { } id ? Positions.LoadReplay(id) : null)
            ?? Positions.Tracks(ids, c.Start.AddSeconds(-3), c.End.AddSeconds(3));
        return tracks;
    }

    private static (float X, float Y)? PlaceAt(List<AionDpsMeter.Timers.Replay.Fix> fixes, DateTime t)
    {
        if (fixes.Count == 0 || t < fixes[0].At.AddSeconds(-2)) return null;
        var i = fixes.FindLastIndex(f => f.At <= t);
        if (i < 0) return (fixes[0].X, fixes[0].Y);
        if (i == fixes.Count - 1) return (fixes[i].X, fixes[i].Y);
        var a = fixes[i];
        var b = fixes[i + 1];
        var k = Math.Clamp((t - a.At).TotalSeconds / Math.Max(0.001, (b.At - a.At).TotalSeconds), 0, 1);
        return ((float)(a.X + (b.X - a.X) * k), (float)(a.Y + (b.Y - a.Y) * k));
    }

    private void TogglePlay(Ctx c)
    {
        playing = !playing;
        player?.Dispose();
        if (!playing) return;
        if (replayT >= c.Dur) replayT = 0;
        player = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            replayT += 0.1 * speed;
            if (built is { } b && replayT >= b.Dur) { replayT = b.Dur; playing = false; player?.Dispose(); }
            StateHasChanged();
        }), null, 100, 100);
    }

    private void SetSpeed(ChangeEventArgs e) =>
        speed = double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 1;

    private void SetReplayT(ChangeEventArgs e) =>
        replayT = double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0;

    private async Task<double[]?> MapBox()
    {
        try
        {
            var r = await JS.InvokeAsync<double[]>("forkBox", mapRef);
            if (r is { Length: 4 } && r[2] > 10 && r[3] > 10) { mapW = r[2]; mapH = r[3]; }
            return r;
        }
        catch (Exception) { return null; }
    }

    /// <summary>The wheel zooms around the cursor (around the group while following it).</summary>
    private async Task ZoomMap(WheelEventArgs e)
    {
        var r = await MapBox();
        var k = mapSpan / Math.Min(mapW, mapH);
        var px = follow || r is not { Length: 4 } ? mapW / 2 : e.ClientX - r[0];
        var py = follow || r is not { Length: 4 } ? mapH / 2 : e.ClientY - r[1];
        var wx = mapCx + (px - mapW / 2) * k;
        var wy = mapCy + (py - mapH / 2) * k;
        mapSpan = Math.Clamp(mapSpan * (e.DeltaY > 0 ? 1.2 : 1 / 1.2), 300, 400_000);
        var k2 = mapSpan / Math.Min(mapW, mapH);
        mapCx = wx - (px - mapW / 2) * k2;
        mapCy = wy - (py - mapH / 2) * k2;
    }

    private async Task MapDragStart(MouseEventArgs e)
    {
        if (e.Button != 0) return;
        await MapBox();
        mapDragging = true;
        follow = false;
        (mapDragX, mapDragY, mapDragCx, mapDragCy) = (e.ClientX, e.ClientY, mapCx, mapCy);
    }

    /// <summary>"Показать всех": everyone's whole path of the fight in view.</summary>
    private void FitAll(List<AionDpsMeter.Timers.Replay.Fix> fixes)
    {
        if (fixes.Count == 0) return;
        var minX = fixes.Min(f => f.X); var maxX = fixes.Max(f => f.X);
        var minY = fixes.Min(f => -f.Y); var maxY = fixes.Max(f => -f.Y);
        mapCx = (minX + maxX) / 2.0;
        mapCy = (minY + maxY) / 2.0;
        mapSpan = Math.Max(1500, Math.Max(maxX - minX, maxY - minY)) * 1.15;
    }

    private string ClassColor(int classId) =>
        TimerOptions.Current.ClassColors.TryGetValue(classId.ToString(CultureInfo.InvariantCulture), out var col) ? col : classId switch
        {
            11 => "#c9a0ff", 12 => "#ff9a3d", 13 => "#41e08c", 14 => "#f5d26b", 15 => "#4fb4ff",
            16 => "#8a7bff", 17 => "#57d6c8", 18 => "#c3d93a", 19 => "#ff6b6b", _ => "#c9d1d9",
        };

    private RenderFragment Replay(Ctx c) => __builder =>
    {
        var all = Tracks(c);
        var fixesAll = all.Values.SelectMany(v => v).ToList();
        if (fixesAll.Count == 0)
        {
            <p class="hv-empty">Для этого боя нет позиций. Повтор записывается для боёв с боссом начиная с этой версии метра: игра присылает места игроков вместе с их движениями и умениями.</p>
            return;
        }
        var t = c.Start.AddSeconds(replayT);
        if (mapSpan <= 0) FitAll(fixesAll);
        if (follow)
        {
            // the group (not the boss) where it is now, the view keeps it in the middle
            var now = all.Where(kv => kv.Key != c.S.TargetId).Select(kv => PlaceAt(kv.Value, t)).OfType<(float X, float Y)>().ToList();
            if (now.Count > 0) { mapCx = now.Average(p => p.X); mapCy = now.Average(p => -p.Y); }
        }
        var span = mapSpan;
        var kk = span / Math.Min(mapW, mapH);
        var vbW = mapW * kk;
        var vbH = mapH * kk;
        var x0 = mapCx - vbW / 2;
        var y0 = mapCy - vbH / 2;
        var vb = $"{F(x0)} {F(y0)} {F(vbW)} {F(vbH)}";
        var hp = BossHp(c);
        var hpNow = hp.LastOrDefault(p => p.Sec <= replayT).Hp;
        var players = c.S.PlayerStats.ToDictionary(p => (int)p.PlayerId);
        var r = span / 90;
        var grid = Math.Pow(10, Math.Floor(Math.Log10(span / 4)));
        var cx = mapCx;
        var cy = -mapCy;
        <div class="hv-body">
            <div class="hv-who">
                <b class="hv-boss">@Target(c.S)</b><span class="hv-bar"></span>
                <span>@Clock(TimeSpan.FromSeconds(replayT)) / @Clock(c.End - c.Start)</span>
                @if (hp.Count > 1) { <span class="teal">HP босса @Pc(hpNow)</span> }
                <span class="hv-grow"></span>
                <label class="hv-follow"><input type="checkbox" checked="@follow" @onchange="e => follow = e.Value is true" /> Следить за группой</label>
                <span class="mute">колесо — масштаб · тянуть мышью — сдвиг</span>
            </div>
            <svg class="hv-map @(mapDragging ? "drag" : "")" @ref="mapRef" viewBox="@vb" preserveAspectRatio="xMidYMid meet"
                 @onwheel="ZoomMap" @onwheel:preventDefault="true" @onmousedown="MapDragStart" @onmousedown:stopPropagation="true">
                @for (var gx = Math.Floor((cx - span) / grid) * grid; gx < cx + span; gx += grid)
                {
                    <line x1="@F(gx)" x2="@F(gx)" y1="@F(-(cy + span))" y2="@F(-(cy - span))" class="hv-map-grid" style="stroke-width:@F(span / 900)" />
                }
                @for (var gy = Math.Floor((cy - span) / grid) * grid; gy < cy + span; gy += grid)
                {
                    <line y1="@F(-gy)" y2="@F(-gy)" x1="@F(cx - span)" x2="@F(cx + span)" class="hv-map-grid" style="stroke-width:@F(span / 900)" />
                }
                @foreach (var (id, fixes) in all)
                {
                    var boss = id == c.S.TargetId;
                    var color = boss ? "#ff5f5f" : players.TryGetValue(id, out var ps) ? ClassColor(ps.ClassId) : "#c9d1d9";
                    var trail = fixes.Where(f => f.At <= t && f.At >= t.AddSeconds(-5)).ToList();
                    if (PlaceAt(fixes, t) is not { } pos) continue;
                    var label = boss ? Target(c.S) : players.TryGetValue(id, out var pn) ? pn.PlayerName : $"#{id}";
                    if (trail.Count > 0)
                    {
                        <polyline class="hv-map-trail" points="@string.Join(" ", trail.Select(f => F(f.X) + "," + F(-f.Y)).Append(F(pos.X) + "," + F(-pos.Y)))" style="stroke:@color;stroke-width:@F(r / 3)" />
                    }
                    <g>
                        <circle cx="@F(pos.X)" cy="@F(-pos.Y)" r="@F(boss ? r * 2.2 : r)" style="fill:@color;stroke:#0b0f14;stroke-width:@F(r / 4)" />
                        <text x="@F(pos.X)" y="@F(-pos.Y - (boss ? r * 3 : r * 1.8))" class="hv-map-name" style="font-size:@F(r * 1.6)px">@label</text>
                    </g>
                }
            </svg>
            <div class="hv-replay-bar">
                <button type="button" class="hv-play" @onclick="() => TogglePlay(c)">@(playing ? "❚❚" : "▶")</button>
                <select class="hv-speed" value="@F(speed)" @onchange="SetSpeed">
                    <option value="0.5">×0.5</option>
                    <option value="1">×1</option>
                    <option value="2">×2</option>
                    <option value="4">×4</option>
                </select>
                <span class="hv-replay-track">
                    @if (hp.Count > 1)
                    {
                        <svg viewBox="0 0 1000 30" preserveAspectRatio="none"><polyline points="@string.Join(" ", hp.Select(p => F(p.Sec / c.Dur * 1000) + "," + F(30 - p.Hp * 28)))" /></svg>
                    }
                    <input type="range" min="0" max="@F(c.Dur)" step="0.1" value="@F(replayT)" @oninput="SetReplayT" />
                </span>
                <button type="button" class="hv-fit" title="Весь путь группы и босса за бой" @onclick="() => { follow = false; FitAll(fixesAll); }">Показать всех</button>
            </div>
            <p class="hv-note">Места — показания самой игры: она присылает их с движениями и умениями, не постоянно, поэтому путь между двумя показаниями нарисован прямой. Показаны только игроки этого боя и босс.</p>
        </div>
    };

    public void Dispose()
    {
        player?.Dispose();
        tick?.Dispose();
        Window.Requested -= OnRequested;
    }
}
