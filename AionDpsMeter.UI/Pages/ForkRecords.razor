@* aion2-overlay fork: new file (see FORK_CHANGES.md). The "Рекорды" tab of the settings window. *@
@using AionDpsMeter.Timers.Records
@using AionDpsMeter.UI.ViewModels
@using System.Globalization
@implements IDisposable
@inject BossRecords Records
@inject AionDpsMeter.Services.Services.Session.CombatSessionManager Sessions
@inject AionDpsMeter.Services.Services.Settings.IAppSettingsService Settings

<div class="fs-label">РЕКОРДЫ ПО БОССАМ</div>
<p class="fr-hint">Нажми на строку — откроется лучший бой с этим боссом (урон по умениям, баффы, график); на «Твой DPS» — бой с твоим лучшим DPS.</p>
@if (message is not null)
{
    <p class="fr-message">@message</p>
}
@if (rows.Count == 0)
{
    <p class="fr-empty">Пока пусто. Рекорд появится после первого убийства босса.</p>
}
else
{
    <div class="fr-table">
        <div class="fr-row fr-head">
            <span>Босс</span><span>Лучшее время</span><span>DPS группы</span><span>Твой DPS</span><span>Убийств</span>
        </div>
        @foreach (var r in rows)
        {
            <div class="fr-row fr-click" @onclick="() => Open(r.BestKillSession)" title="@($"HP {Hp(r.HpTotal)} · рекорд {r.BestKillAt:dd.MM HH:mm} · последний бой {RecordText.Time(r.LastKill)}")">
                <span class="fr-boss">@r.Boss <small>@Hp(r.HpTotal)</small></span>
                <span class="fr-best">@RecordText.Time(r.BestKill)</span>
                <span>@DamageFormatter.Format(r.BestPartyDps)/s</span>
                <span class="fr-link" @onclick="() => Open(r.BestMyDpsSession)" @onclick:stopPropagation="true">@(r.BestMyDps > 0 ? DamageFormatter.Format(r.BestMyDps) + "/s" : "—")</span>
                <span>@r.Kills</span>
            </div>
        }
    </div>
    <div class="fr-actions">
        @if (confirmClear)
        {
            <span>Удалить все рекорды?</span>
            <button type="button" class="fs-segmented__option fs-button" @onclick="Clear">Да, удалить</button>
            <button type="button" class="fs-segmented__option fs-button" @onclick="() => confirmClear = false">Нет</button>
        }
        else
        {
            <button type="button" class="fs-segmented__option fs-button" @onclick="() => confirmClear = true">Сбросить рекорды</button>
        }
    </div>
}

@code {
    private IReadOnlyList<BossRecord> rows = [];
    private bool confirmClear;
    private string? message;

    /// <summary>Opens the fight in upstream's history window, the same one the history list opens.</summary>
    private void Open(Guid? sessionId)
    {
        message = null;
        var fight = sessionId is { } id ? Sessions.GetHistorySession(id) : null;
        if (fight is null)
        {
            message = "Подробностей этого боя уже нет: история боёв хранится 30 дней. Следующий рекорд откроется.";
            return;
        }
        new AionDpsMeter.UI.HistorySessionWindow(Settings)
        {
            DataContext = new AionDpsMeter.UI.ViewModels.History.HistorySessionViewModel(fight, Settings),
        }.Show();
    }

    protected override void OnInitialized()
    {
        rows = Records.All();
        Records.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(() => { rows = Records.All(); StateHasChanged(); });

    private void Clear()
    {
        confirmClear = false;
        Records.Clear();
    }

    /// <summary>Difficulty tells apart the same boss with other HP: "8.2M".</summary>
    private static string Hp(long hp) => (hp / 1_000_000.0).ToString("0.#", CultureInfo.InvariantCulture) + "M";

    public void Dispose() => Records.Changed -= OnChanged;
}
