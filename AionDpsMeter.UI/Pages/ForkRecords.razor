@* aion2-overlay fork: new file (see FORK_CHANGES.md). The "Рекорды" tab of the settings window, in the fork's card design:
   totals on top, search and sorting, one card per boss; a card opens its best fight in "История боёв". *@
@using AionDpsMeter.Timers.Records
@using AionDpsMeter.UI.Utils
@using System.Globalization
@implements IDisposable
@inject BossRecords Records
@inject AionDpsMeter.UI.Services.TimerWindow.HistoryBrowserWindow History
@inject AionDpsMeter.Services.Services.Session.Persistence.ICombatHistoryStore Store

<div class="fs-label">РЕКОРДЫ ПО БОССАМ</div>
@if (rows.Count == 0)
{
    <div class="fr-empty">
        <b>🏆 Пока пусто</b>
        <span>Рекорд появится после первого убийства босса: лучшее время, DPS группы и твой DPS.</span>
    </div>
}
else
{
    var fastest = rows.MinBy(r => r.BestKill)!;
    var topParty = rows.MaxBy(r => r.BestPartyDps)!;
    <div class="fr-stats">
        <div class="fr-stat"><small>Боссов</small><b>@rows.Count</b></div>
        <div class="fr-stat"><small>Убийств</small><b>@rows.Sum(r => r.Kills)</b></div>
        <div class="fr-stat"><small>Быстрее всего</small><b class="gold">@RecordText.Time(fastest.BestKill)</b><em>@fastest.Boss</em></div>
        <div class="fr-stat"><small>Лучший DPS группы</small><b class="teal">@DamageFormatter.Format(topParty.BestPartyDps)/s</b><em>@topParty.Boss</em></div>
    </div>

    <div class="fr-tools">
        <input class="fr-search" type="search" placeholder="Поиск босса…" value="@query" @oninput="e => query = e.Value?.ToString() ?? string.Empty" />
        <div class="fr-seg">
            @foreach (var (id, label) in Sorts)
            {
                <button type="button" class="@(sort == id ? "on" : "")" @onclick="() => sort = id">@label</button>
            }
        </div>
    </div>
    @if (message is not null)
    {
        <p class="fr-message">@message</p>
    }

    <div class="fr-list">
        @foreach (var r in Shown())
        {
            var faster = r.PreviousBestKill is { } prev && prev > r.BestKill ? prev - r.BestKill : (TimeSpan?)null;
            <div class="fr-card" @onclick="() => Open(r.BestKillSession)" title="Открыть лучший бой">
                <div class="fr-boss">
                    <b>@r.Boss</b>
                    <span><i class="fr-hp">@Hp(r.HpTotal) HP</i> последний бой @(r.LastKillAt == default ? "—" : r.LastKillAt.ToString("dd.MM HH:mm"))</span>
                </div>
                <div class="fr-time">
                    <small>ЛУЧШЕЕ ВРЕМЯ</small>
                    <b>@RecordText.Time(r.BestKill)</b>
                    <span>@r.BestKillAt.ToString("dd.MM.yy")@if (faster is { } f) { <em>−@RecordText.Time(f) к прошлому</em> }</span>
                </div>
                <div class="fr-num"><small>DPS ГРУППЫ</small><b>@DamageFormatter.Format(r.BestPartyDps)/s</b></div>
                <div class="fr-num fr-mine" @onclick="() => Open(r.BestMyDpsSession)" @onclick:stopPropagation="true" title="Открыть бой с твоим лучшим DPS">
                    <small>ТВОЙ DPS</small><b>@(r.BestMyDps > 0 ? DamageFormatter.Format(r.BestMyDps) + "/s" : "—")</b>
                </div>
                <div class="fr-num"><small>УБИЙСТВ</small><b>@r.Kills</b></div>
                <span class="fr-go">↗</span>
            </div>
        }
        @if (!Shown().Any())
        {
            <p class="fr-none">Ничего не найдено.</p>
        }
    </div>

    <div class="fr-actions">
        @if (confirmClear)
        {
            <span>Удалить все рекорды? Это нельзя отменить.</span>
            <button type="button" class="fr-btn danger" @onclick="Clear">Да, удалить</button>
            <button type="button" class="fr-btn" @onclick="() => confirmClear = false">Нет</button>
        }
        else
        {
            <button type="button" class="fr-btn" @onclick="() => confirmClear = true">Сбросить рекорды</button>
        }
    </div>
}

@code {
    private static readonly (string Id, string Label)[] Sorts =
        [("recent", "Недавние"), ("time", "Время"), ("party", "DPS группы"), ("mine", "Мой DPS"), ("kills", "Убийства")];

    private IReadOnlyList<BossRecord> rows = [];
    private bool confirmClear;
    private string? message;
    private string query = "";
    private string sort = "recent";

    private IEnumerable<BossRecord> Shown()
    {
        var list = rows.Where(r => query.Length == 0 || r.Boss.Contains(query, StringComparison.OrdinalIgnoreCase));
        return sort switch
        {
            "time" => list.OrderBy(r => r.BestKill),
            "party" => list.OrderByDescending(r => r.BestPartyDps),
            "mine" => list.OrderByDescending(r => r.BestMyDps),
            "kills" => list.OrderByDescending(r => r.Kills),
            _ => list.OrderByDescending(r => r.LastKillAt),
        };
    }

    /// <summary>Opens the fight in the fork's "История боёв".</summary>
    private void Open(Guid? sessionId)
    {
        message = null;
        var known = false;
        try { known = sessionId is { } id && Store.GetSession(id) is not null; }
        catch (Exception) { }
        if (!known)
        {
            message = "Подробностей этого боя уже нет: история боёв хранится 30 дней. Следующий рекорд откроется.";
            return;
        }
        History.Open(session: sessionId);
    }

    protected override void OnInitialized()
    {
        rows = Records.All();
        Records.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(() => { rows = Records.All(); StateHasChanged(); });

    private void Clear()
    {
        confirmClear = false;
        Records.Clear();
    }

    /// <summary>Difficulty tells apart the same boss with other HP: "8.2M".</summary>
    private static string Hp(long hp) => (hp / 1_000_000.0).ToString("0.#", CultureInfo.InvariantCulture) + "M";

    public void Dispose() => Records.Changed -= OnChanged;
}
