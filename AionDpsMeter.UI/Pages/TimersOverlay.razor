@using AionDpsMeter.Timers.Feed
@implements IDisposable

<div class="timers" style="zoom:@(Options.UiScale)%">
    <div class="timers__header" @onmousedown="Drag">
        <span class="timers__title">☠ @(Collapsed && toast is not null ? toast : "Таймеры боссов")</span>
        <button type="button" title="@(Collapsed ? "Развернуть" : "Свернуть")" @onclick="ToggleCollapsed" @onmousedown:stopPropagation="true">@(Collapsed ? "▸" : "▾")</button>
        <button type="button" title="Скрыть окно (вернуть — в ⚙ Настройки)" @onclick="HideWindow" @onmousedown:stopPropagation="true">✕</button>
    </div>
    @if (!Collapsed)
    {
        @if (toast is not null)
        {
            <div class="timers__toast">@toast</div>
        }
        <div class="timers__list">
            @foreach (var item in visible)
            {
                <div class="timers__row timers__row--@item.Status.ToString().ToLowerInvariant()">
                    <span class="timers__icon">@KindIcon(item.Kind)</span>
                    <span class="timers__name">
                        @item.Title
                        @if (!item.Verified)
                        {
                            <em> (не проверено)</em>
                        }
                        @if (item.Zone is not null)
                        {
                            <small>@item.Zone</small>
                        }
                    </span>
                    <span class="timers__time">@FeedText.Format(item, now, TimeZoneInfo.Local)</span>
                    <span class="timers__actions">
                        @if (item.BossKey is not null)
                        {
                            <button title="Отметить убитым" @onclick="() => MarkKilled(item)">убит</button>
                        }
                        <button title="Скрыть строку" @onclick="() => Hide(item)">×</button>
                    </span>
                </div>
            }
            @if (visible.Count == 0)
            {
                <div class="timers__empty">Боссов пока нет. Открой карту в игре — появятся полевые боссы.</div>
            }
        </div>
    }
</div>
