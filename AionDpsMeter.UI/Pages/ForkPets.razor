@* aion2-overlay fork: new file (see FORK_CHANGES.md). The "Питомцы" tab of the settings window, in the fork's card design:
   level tiles that filter, search by pet or monster, sorting and toggles, one card per pet with its souls bar. *@
@using AionDpsMeter.Timers.Pets
@using System.Globalization
@inject PetTracker Pets
@inject AionDpsMeter.Timers.Schedule.ScheduleSource Schedule
@inject AionDpsMeter.UI.Services.TimerWindow.MapWindow MapWindow
@inject AionDpsMeter.Timers.Bosses.BossCatalog Catalog

<div class="fs-label">ПИТОМЦЫ</div>
@if (rows.Count == 0)
{
    <div class="fp-empty">
        <b>🐾 Пока пусто</b>
        <span>Уровни всех питомцев игра присылает при входе в игру: перезайди персонажем.</span>
    </div>
}
else
{
    <div class="fp-levels">
        <button type="button" class="fp-level @(level is null ? "on" : "")" @onclick="() => level = null">
            <small>Все</small><b>@rows.Count</b><i class="fp-mini"><i style="width:100%"></i></i>
        </button>
        @for (var l = 0; l <= PetBook.MaxLevel; l++)
        {
            var lv = l;
            var count = rows.Count(r => Math.Min(r.View.Level, PetBook.MaxLevel) == lv);
            <button type="button" class="fp-level lv@(lv) @(level == lv ? "on" : "")" @onclick="() => level = level == lv ? null : lv">
                <small>@LevelName(lv)</small><b>@count</b>
                <i class="fp-mini"><i style="width:@((count * 100.0 / rows.Count).ToString("0.#", CultureInfo.InvariantCulture))%"></i></i>
            </button>
        }
    </div>

    <div class="fp-tools">
        <input class="fp-search" type="search" placeholder="Питомец или монстр…" value="@query" @oninput="e => query = e.Value?.ToString() ?? string.Empty" />
        <div class="fp-seg">
            @foreach (var (id, label) in Sorts)
            {
                <button type="button" class="@(sort == id ? "on" : "")" @onclick="() => sort = id">@label</button>
            }
        </div>
    </div>
    <div class="fp-toggles">
        <button type="button" class="fp-tog @(hideMaxed ? "on" : "")" @onclick="() => hideMaxed = !hideMaxed"><i></i>Скрыть максимальные</button>
        <button type="button" class="fp-tog @(knownMonster ? "on" : "")" @onclick="() => knownMonster = !knownMonster"><i></i>Монстр известен</button>
        <button type="button" class="fp-tog @(gainedToday ? "on" : "")" @onclick="() => gainedToday = !gainedToday"><i></i>Души за сессию</button>
        <span class="fp-count">показано @Shown().Count() из @rows.Count</span>
    </div>
    <p class="fp-hint">Точное число душ игра присылает при входе персонажа, дальше метр считает сам; «?» — перезайди, чтобы оно пришло. Монстра метр узнаёт, когда с него падает душа.</p>

    <div class="fp-grid">
        @foreach (var (view, monster) in Shown())
        {
            var name = Schedule.Current.PetName(view.Pet) ?? $"№ {view.Pet}";
            var maxed = view.Level >= PetBook.MaxLevel;
            var share = view.Souls is { } s0 ? Math.Min(1, s0 / (double)Math.Max(1, view.Need)) : 0;
            <div class="fp-card @(maxed ? "maxed" : "")">
                <div class="fp-head">
                    <span class="fp-badge lv@(Math.Min(view.Level, PetBook.MaxLevel))">@(maxed ? "★" : view.Level.ToString())</span>
                    <span class="fp-name" title="@name"><b>@name</b><small>@LevelName(Math.Min(view.Level, PetBook.MaxLevel))</small></span>
                    @if (view.SessionGain > 0) { <em class="fp-gain">+@view.SessionGain</em> }
                </div>
                @if (maxed)
                {
                    <div class="fp-done">Максимальный уровень</div>
                }
                else
                {
                    <div class="fp-progress">
                        <i class="fp-bar"><i style="width:@((share * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></i>
                        <span>
                            <b>@(view.Souls?.ToString() ?? "?") / @view.Need</b>
                            @if (view.Souls is { } s) { <small>осталось @Math.Max(0, view.Need - s) · @((share * 100).ToString("0", CultureInfo.InvariantCulture))%</small> }
                            else { <small>перезайди, чтобы узнать</small> }
                        </span>
                    </div>
                }
                @{
                    var places = AionDpsMeter.Timers.Map.WorldMap.PlacesOf(view.Pet);
                    var shownMonster = monster ?? MapMonsters(places);
                }
                <div class="fp-foot">
                    <div class="fp-monster @(shownMonster is null ? "unknown" : "")" title="@shownMonster">🎯 @(shownMonster ?? "монстр ещё не известен")</div>
                    @if (places.Count > 0)
                    {
                        <button type="button" class="fp-map" title="@($"Показать на карте: {string.Join(", ", places.Select(p => $"{p.Layer.Name} — {p.Points.Count} мест"))}")" @onclick="() => MapWindow.ShowPet(view.Pet)">🗺 На карте</button>
                    }
                </div>
            </div>
        }
    </div>
    @if (!Shown().Any())
    {
        <p class="fp-none">По этим фильтрам питомцев нет.</p>
    }
}

@code {
    private static readonly (string Id, string Label)[] Sorts = [("close", "Ближе к уровню"), ("name", "По имени"), ("level", "По уровню")];

    private IReadOnlyList<(PetView View, string? Monster)> rows = [];
    private bool hideMaxed = true, knownMonster, gainedToday;
    private int? level;
    private string query = "";
    private string sort = "close";

    private IEnumerable<(PetView View, string? Monster)> Shown()
    {
        var list = rows.Where(r =>
            (level is null || Math.Min(r.View.Level, PetBook.MaxLevel) == level)
            && (!hideMaxed || level == PetBook.MaxLevel || r.View.Level < PetBook.MaxLevel)
            && (!knownMonster || r.Monster is not null)
            && (!gainedToday || r.View.SessionGain > 0)
            && (query.Length == 0
                || (Schedule.Current.PetName(r.View.Pet) ?? "").Contains(query, StringComparison.OrdinalIgnoreCase)
                || (r.Monster ?? "").Contains(query, StringComparison.OrdinalIgnoreCase)));
        return sort switch
        {
            "name" => list.OrderBy(r => Schedule.Current.PetName(r.View.Pet) ?? $"№ {r.View.Pet}"),
            "level" => list.OrderByDescending(r => r.View.Level).ThenByDescending(r => r.View.Souls ?? 0),
            _ => list, // the tracker's own order: closest to the next level first
        };
    }

    /// <summary>The pet's monsters by name from the map table, while the meter has not yet seen a soul drop.</summary>
    private string? MapMonsters(IReadOnlyList<(AionDpsMeter.Timers.Map.MapLayer Layer, IReadOnlyList<AionDpsMeter.Timers.Map.MapPoint> Points, IReadOnlyList<int> Monsters)> places)
    {
        var names = places.SelectMany(p => p.Monsters).Select(Catalog.NameOrNull).OfType<string>().Distinct().Take(3).ToList();
        return names.Count == 0 ? null : string.Join(", ", names);
    }

    private static string LevelName(int level) => level switch
    {
        0 => "сбор",
        >= PetBook.MaxLevel => "макс.",
        _ => $"ур. {level}",
    };

    protected override void OnInitialized() => rows = Pets.All();
}
