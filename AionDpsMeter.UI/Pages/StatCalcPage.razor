@* aion2-overlay fork: new file (see FORK_CHANGES.md). Upstream's stat efficiency calculator in the fork's design and in
   Russian: the result on top, then the character's stats from the game, the fight setup and the option simulator. *@
@using System.Globalization
@using AionDpsMeter.Services.Services.Session
@using AionDpsMeter.Services.Services.Settings
@using AionDpsMeter.UI.ViewModels
@using AionDpsMeter.UI.StatEfficiency
@using AionDpsMeter.UI.Services.TimerWindow
@implements IDisposable
@inject CombatSessionManager Sessions
@inject IAppSettingsService Settings
@inject StatCalcWindow Window

<div class="sc">
    <div class="sc-title" @onmousedown="Window.Drag">
        <b>Калькулятор статов</b>
        <span class="sc-sub">сколько урона даст новая опция</span>
        <span class="sc-grow"></span>
        <button type="button" class="sc-btn" @onmousedown:stopPropagation="true" @onclick="Reload">⟳ Взять из игры</button>
        <button type="button" class="sc-x" @onmousedown:stopPropagation="true" @onclick="Window.Close">✕</button>
    </div>

    <div class="sc-body">
        <div class="sc-hero">
            <div class="sc-gain @(vm.DamageGainPercent > 0.0001 ? "up" : vm.DamageGainPercent < -0.0001 ? "down" : "")">
                <small>ПРИРОСТ УРОНА</small>
                <b>@(vm.DamageGainPercent > 0 ? "+" : "")@vm.DamageGainPercent.ToString("0.00", CultureInfo.InvariantCulture)%</b>
            </div>
            <div class="sc-kv"><small>Индекс урона сейчас</small><b>@N(vm.TotalDamage)</b></div>
            <div class="sc-arrow">→</div>
            <div class="sc-kv"><small>С новой опцией</small><b class="teal">@N(vm.TotalDamage2)</b></div>
            <div class="sc-kv sc-kv--wide"><small>Эффективная атака</small><b>@N(vm.EffectiveAttack) <span class="mute">→</span> @N(vm.EffectiveAttack2)</b></div>
        </div>
        @if (hasSnapshot && OptionAttack.Concat(OptionMultipliers).All(f => f.Get(vm) == 0))
        {
            <div class="sc-hint">Индекс — условный урон по вашим статам, сам по себе он ничего не значит. Впишите прибавку новой вещи или опции в «Симулятор опции» справа (например, +120 к атаке или +2 к усилению урона) — сверху покажется, на сколько процентов вырастет урон. Ниже — что выгоднее качать прямо сейчас.</div>
        }
        @if (hasSnapshot)
        {
            var worth = Worth();
            var best = Math.Max(0.0001, worth.Max(w => Math.Abs(w.Gain)));
            <div class="sc-box">
                <div class="sc-cap">ЧТО ДАСТ БОЛЬШЕ УРОНА <span>прирост от одной прибавки при ваших статах и настройке боя</span></div>
                <div class="sc-worth">
                    @foreach (var w in worth)
                    {
                        <div class="sc-wrow">
                            <span>@w.Label</span>
                            <i class="sc-wbar"><i style="width:@((Math.Abs(w.Gain) / best * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></i>
                            <b>@(w.Gain >= 0 ? "+" : "")@w.Gain.ToString("0.00", CultureInfo.InvariantCulture)%</b>
                        </div>
                    }
                </div>
            </div>
        }
        @if (!hasSnapshot)
        {
            <div class="sc-warn">Характеристики персонажа ещё не получены. Игра присылает их при входе в игру и когда они меняются — перезайдите на персонажа или смените предмет экипировки, затем нажмите «⟳ Взять из игры». Метр запомнит их и после перезапуска.</div>
        }

        <div class="sc-cols">
            <div class="sc-col">
                <div class="sc-cap">ХАРАКТЕРИСТИКИ ИЗ ИГРЫ <span>@(capturedAt is { } at ? $"получены {at:dd.MM HH:mm}" : "")@(edited ? " · изменены вручную" : "")</span>
                    @if (edited) { <button type="button" class="sc-link" @onclick="Reload">Вернуть из игры</button> }
                </div>
                @Group("Атака", Attack, false)
                @Group("Множители урона", Multipliers, false)
                @Group("Итог", Derived, false)
            </div>
            <div class="sc-col">
                <div class="sc-cap">НАСТРОЙКА БОЯ <span>сохраняется</span></div>
                @Group("Баффы группы", Buffs, false)
                @Group("Защита босса", BossDefense, false)
                @Group("Допущения", Assumptions, false)
                <div class="sc-group">
                    <div class="sc-gtitle">Атака с позиции</div>
                    <div class="sc-seg">
                        <button type="button" class="@(vm.SelectedAttackType == AttackType.None ? "on" : "")" @onclick="() => vm.SelectedAttackType = AttackType.None">Нет</button>
                        <button type="button" class="@(vm.SelectedAttackType == AttackType.Front ? "on" : "")" @onclick="() => vm.SelectedAttackType = AttackType.Front">Спереди</button>
                        <button type="button" class="@(vm.SelectedAttackType == AttackType.Back ? "on" : "")" @onclick="() => vm.SelectedAttackType = AttackType.Back">Сзади</button>
                    </div>
                </div>
            </div>
            <div class="sc-col">
                <div class="sc-cap">СИМУЛЯТОР ОПЦИИ <span>Δ, можно минус</span>
                    <button type="button" class="sc-link" @onclick="ResetOptions">Сбросить</button>
                </div>
                @Group("Атака", OptionAttack, false)
                @Group("Множители урона", OptionMultipliers, false)
            </div>
        </div>
    </div>
</div>

@code {
    private sealed record Field(string Label, Func<StatEfficiencyCalculatorViewModel, double> Get, Action<StatEfficiencyCalculatorViewModel, double>? Set, bool Percent);

    private static Field Ro(string label, Func<StatEfficiencyCalculatorViewModel, double> get, bool pct = false) => new(label, get, null, pct);
    private static Field Rw(string label, Func<StatEfficiencyCalculatorViewModel, double> get, Action<StatEfficiencyCalculatorViewModel, double> set, bool pct = true) => new(label, get, set, pct);

    private static readonly Field[] Attack =
    [
        Rw("Бонус атаки", v => v.BaseAttack, (v, x) => v.BaseAttack = x, false), Rw("Атака", v => v.GearAttack, (v, x) => v.GearAttack = x, false),
        Rw("Мин. атака", v => v.MinAttack, (v, x) => v.MinAttack = x, false), Rw("Макс. атака", v => v.MaxAttack, (v, x) => v.MaxAttack = x, false),
        Rw("Атака PvE", v => v.PveAttack, (v, x) => v.PveAttack = x, false), Rw("Атака по боссам", v => v.BossAttack, (v, x) => v.BossAttack = x, false),
        Rw("Увеличение атаки", v => v.AttackIncreasePercent, (v, x) => v.AttackIncreasePercent = x),
    ];

    private static readonly Field[] Multipliers =
    [
        Rw("Усиление урона", v => v.DamageBoostPercent, (v, x) => v.DamageBoostPercent = x),
        Rw("Усиление урона оружием", v => v.WeaponDamageBoostPercent, (v, x) => v.WeaponDamageBoostPercent = x),
        Rw("Усиление урона PvE", v => v.PveDamageBoostPercent, (v, x) => v.PveDamageBoostPercent = x),
        Rw("Усиление урона по боссам", v => v.BossDamageBoostPercent, (v, x) => v.BossDamageBoostPercent = x),
        Rw("Усиление крит. урона", v => v.CriticalDamageBoostPercent, (v, x) => v.CriticalDamageBoostPercent = x),
        Rw("Идеальный удар", v => v.PerfectPercent, (v, x) => v.PerfectPercent = x),
        Rw("Двойной удар", v => v.SmitePercent, (v, x) => v.SmitePercent = x),
        Rw("Урон спереди", v => v.FrontDamageBoostPercent, (v, x) => v.FrontDamageBoostPercent = x),
        Rw("Урон сзади", v => v.BackDamageBoostPercent, (v, x) => v.BackDamageBoostPercent = x),
        Rw("Урон по расам", v => v.RaceDamageBoostPercent, (v, x) => v.RaceDamageBoostPercent = x),
    ];

    private static readonly Field[] Derived =
    [
        Rw("Скорость боя", v => v.CombatSpeedPercent, (v, x) => v.CombatSpeedPercent = x),
        Ro("Атака в окне персонажа", v => v.StatWindowAttack), Ro("Эффективная атака", v => v.EffectiveAttack),
    ];

    private static readonly Field[] Buffs =
    [
        Rw("Увеличение атаки", v => v.AttackIncreaseCombatPercent, (v, x) => v.AttackIncreaseCombatPercent = x),
        Rw("Усиление крит. урона", v => v.CriticalDamageBoost, (v, x) => v.CriticalDamageBoost = x),
        Rw("Усиление урона", v => v.PartyDamageBoost, (v, x) => v.PartyDamageBoost = x),
        Rw("Двойной удар", v => v.PartySmiteBuff, (v, x) => v.PartySmiteBuff = x),
    ];

    private static readonly Field[] BossDefense =
    [
        Rw("Сопротивление урону", v => v.BossDamageTolerance, (v, x) => v.BossDamageTolerance = x),
        Rw("Сопротивление двойному удару", v => v.BossSmiteResist, (v, x) => v.BossSmiteResist = x),
    ];

    private static readonly Field[] Assumptions =
    [
        Rw("Шанс крита", v => v.CritChance, (v, x) => v.CritChance = x),
        Rw("Доля ударов в спину", v => v.BackAttackRate, (v, x) => v.BackAttackRate = x),
        Rw("Доля ударов спереди", v => v.FrontAttackRate, (v, x) => v.FrontAttackRate = x),
    ];

    private static readonly Field[] OptionAttack =
    [
        Rw("Бонус атаки", v => v.OptionBaseAttack, (v, x) => v.OptionBaseAttack = x, false),
        Rw("Атака", v => v.OptionGearAttack, (v, x) => v.OptionGearAttack = x, false),
        Rw("Мин. атака", v => v.OptionMinAttack, (v, x) => v.OptionMinAttack = x, false),
        Rw("Макс. атака", v => v.OptionMaxAttack, (v, x) => v.OptionMaxAttack = x, false),
        Rw("Атака PvE", v => v.OptionPveAttack, (v, x) => v.OptionPveAttack = x, false),
        Rw("Атака по боссам", v => v.OptionBossAttack, (v, x) => v.OptionBossAttack = x, false),
        Rw("Увеличение атаки", v => v.OptionAttackIncreasePercent, (v, x) => v.OptionAttackIncreasePercent = x),
    ];

    private static readonly Field[] OptionMultipliers =
    [
        Rw("Усиление урона", v => v.OptionDamageBoostPercent, (v, x) => v.OptionDamageBoostPercent = x),
        Rw("Усиление урона оружием", v => v.OptionWeaponDamageBoostPercent, (v, x) => v.OptionWeaponDamageBoostPercent = x),
        Rw("Усиление крит. урона", v => v.OptionCriticalDamageBoostPercent, (v, x) => v.OptionCriticalDamageBoostPercent = x),
        Rw("Идеальный удар", v => v.OptionPerfectPercent, (v, x) => v.OptionPerfectPercent = x),
        Rw("Двойной удар", v => v.OptionSmitePercent, (v, x) => v.OptionSmitePercent = x),
        Rw("Урон спереди", v => v.OptionFrontDamageBoostPercent, (v, x) => v.OptionFrontDamageBoostPercent = x),
        Rw("Урон сзади", v => v.OptionBackDamageBoostPercent, (v, x) => v.OptionBackDamageBoostPercent = x),
    ];

    private static readonly (string Label, Field Field, double Step)[] Steps =
    [
        ("+100 атаки", OptionAttack[1], 100), ("+10 бонуса атаки", OptionAttack[0], 10), ("+100 атаки по боссам", OptionAttack[5], 100),
        ("+100 атаки PvE", OptionAttack[4], 100), ("+1% увеличения атаки", OptionAttack[6], 1), ("+1% усиления урона", OptionMultipliers[0], 1),
        ("+1% усиления урона оружием", OptionMultipliers[1], 1), ("+1% усиления крит. урона", OptionMultipliers[2], 1),
        ("+1% идеального удара", OptionMultipliers[3], 1), ("+1% двойного удара", OptionMultipliers[4], 1), ("+1% урона сзади", OptionMultipliers[6], 1),
    ];

    /// <summary>Each step alone on top of the current stats, the options typed in put back afterwards.</summary>
    private List<(string Label, double Gain)> Worth()
    {
        var all = OptionAttack.Concat(OptionMultipliers).ToArray();
        var saved = all.Select(f => f.Get(vm)).ToArray();
        foreach (var f in all) f.Set!(vm, 0);
        var result = new List<(string Label, double Gain)>();
        foreach (var (label, field, step) in Steps)
        {
            field.Set!(vm, step);
            result.Add((label, vm.DamageGainPercent));
            field.Set!(vm, 0);
        }
        for (var i = 0; i < all.Length; i++) all[i].Set!(vm, saved[i]);
        return result.OrderByDescending(x => x.Gain).ToList();
    }

    private StatEfficiencyCalculatorViewModel vm = null!;
    private bool hasSnapshot, edited;
    private DateTime? capturedAt;

    protected override void OnInitialized()
    {
        vm = new StatEfficiencyCalculatorViewModel(Settings);
        Reload();
        Window.Requested += OnRequested;
    }

    private void OnRequested() => InvokeAsync(() => { Reload(); StateHasChanged(); });

    private void Reload()
    {
        var snapshot = Sessions.GetCurrentPlayerStatSnapshot() ?? AionDpsMeter.Services.PacketProcessing.Fork.StatsMemory.Last;
        hasSnapshot = snapshot?.Stats is not null;
        capturedAt = snapshot?.CapturedAt;
        edited = false;
        vm.LoadFromSnapshot(snapshot);
    }

    private void ResetOptions()
    {
        foreach (var f in OptionAttack.Concat(OptionMultipliers)) f.Set!(vm, 0);
    }

    private RenderFragment Group(string title, Field[] fields, bool readOnly) => __builder =>
    {
        <div class="sc-group">
            <div class="sc-gtitle">@title</div>
            @foreach (var f in fields)
            {
                var field = f;
                <label class="sc-row">
                    <span>@f.Label@(f.Percent ? ", %" : "")</span>
                    @if (readOnly || f.Set is null)
                    {
                        <b>@Value(f.Get(vm), f.Percent)</b>
                    }
                    else
                    {
                        <input type="number" step="any" value="@Raw(f.Get(vm))" @onchange="e => Set(field, e)" />
                    }
                </label>
            }
        </div>
    };

    private void Set(Field f, ChangeEventArgs e)
    {
        var text = (e.Value?.ToString() ?? "").Replace(',', '.').Trim();
        f.Set!(vm, double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : 0);
        if (Attack.Contains(f) || Multipliers.Contains(f) || Derived.Contains(f)) edited = true;
    }

    private static string Raw(double v) => v.ToString("0.####", CultureInfo.InvariantCulture);
    private static string Value(double v, bool pct) => pct ? v.ToString("0.##", CultureInfo.InvariantCulture) + "%" : v.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));
    private static string N(double v) => v.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));

    public void Dispose() => Window.Requested -= OnRequested;
}
