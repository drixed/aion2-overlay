@* aion2-overlay fork: new file (see FORK_CHANGES.md). "История боёв": fights on the left, the chosen fight's tabs on the right. *@
@using System.Globalization
@using AionDpsMeter.Services.Models
@using AionDpsMeter.Services.Services.Session
@using AionDpsMeter.Timers.Modes
@using AionDpsMeter.UI.Services.TimerWindow
@implements IDisposable
@inject AionDpsMeter.Services.Services.Session.Persistence.ICombatHistoryStore Store
@inject CombatSessionManager Sessions
@inject MeterModesService Modes
@inject AionDpsMeter.UI.Services.TimerWindow.HistoryBrowserWindow Window
@inject AionDpsMeter.UI.Services.TimerWindow.HistoryViewWindow Views
@inject AionDpsMeter.Timers.Feed.TimersOptionsStore Options

<div class="hb">
    <div class="hb-head" @onmousedown="Window.Drag">
        <b>История боёв</b>
        @if (snap is { } h)
        {
            <span class="hb-sub">@Title(h) · @h.SessionStart.ToString("dd.MM HH:mm") · @Clock(h.Duration) · @Fmt(h.PlayerStats.Sum(p => p.TotalDamage)) урона</span>
        }
        <span class="hb-tabs" @onmousedown:stopPropagation="true">
            @foreach (var (id, label) in Tabs)
            {
                <button type="button" class="@(tab == id ? "on" : "")" @onclick="() => tab = id">@label</button>
            }
        </span>
        <button type="button" class="hb-close" @onmousedown:stopPropagation="true" @onclick="Window.Close">✕</button>
    </div>
    <div class="hb-main">
        <aside class="hb-list">
            <input class="hb-search" placeholder="Поиск по боссу…" value="@query" @oninput="OnSearch" />
            <button type="button" class="hb-item @(selected is null ? "on" : "")" @onclick="() => Select(null)">
                <span class="hb-item-name">● Текущий бой</span>
                <span class="hb-item-meta">@(Sessions.GetActiveTargetSession() is null ? "нет боя" : "идёт сейчас")</span>
            </button>
            @foreach (var item in items)
            {
                <button type="button" class="hb-item @(selected == item.SessionId ? "on" : "")" @onclick="() => Select(item.SessionId)">
                    <span class="hb-item-name">@(string.IsNullOrWhiteSpace(item.TargetName) ? "Бой" : item.TargetName)</span>
                    <span class="hb-item-meta">@item.SessionStart.ToString("dd.MM HH:mm") · @Clock(item.Duration) · @Fmt(item.TotalDamage) · @item.PlayerCount игр.</span>
                </button>
            }
        </aside>
        <section class="hb-body">
            @if (snap is not { } s || s.PlayerStats.Count == 0)
            {
                <p class="hb-empty">Выбери бой слева. Текущий бой появится после первого удара.</p>
            }
            else if (tab == "damage")
            {
                var players = s.PlayerStats.OrderByDescending(p => p.TotalDamage).ToList();
                var max = Math.Max(1, players.Max(p => p.TotalDamage));
                <div class="hb-table hb-players">
                    <div class="hb-tr hb-th"><span>Игрок</span><span>ГС</span><span>Урон</span><span>%</span><span>DPS</span><span>Крит</span><span>Спина</span><span>Идеал</span><span>Смерти</span></div>
                    @foreach (var p in players)
                    {
                        <div class="hb-tr @(p.PlayerId == player ? "on" : "") @(p.IsUser ? "me" : "")" @onclick="() => player = p.PlayerId">
                            <i class="hb-fill" style="width:@Pct(p.TotalDamage, max)"></i>
                            <span class="hb-name"><span class="hb-icon" style="background-image:url('/images/classes/@(p.ClassId).png')"></span>@p.PlayerName</span>
                            <span>@(p.CombatPower > 0 ? p.CombatPower.ToString("N0", CultureInfo.InvariantCulture) : "—")</span>
                            <b>@Fmt(p.TotalDamage)</b><span>@P(p.DamagePercentage)</span><span>@Fmt(p.DamagePerSecond)</span>
                            <span>@P(p.CriticalRate)</span><span>@P(p.BackAttackRate)</span><span>@P(p.PerfectRate)</span><span>@p.PlayerDeaths</span>
                        </div>
                    }
                </div>
                @if (players.FirstOrDefault(p => p.PlayerId == player) is { } who && s.SkillStatsByPlayer.TryGetValue(who.PlayerId, out var skillSet))
                {
                    var skills = skillSet.OrderByDescending(k => k.TotalDamage).ToList();
                    var whoHits = s.HitsByPlayer.TryGetValue(who.PlayerId, out var wh) ? wh : [];
                    var castCount = Timeline.Casts(whoHits.Where(h => h.Skill is not null).Select(h => (h.DateTime, h.Skill.Id))).Count;
                    var active = Timeline.Uptime(Timeline.Merge(whoHits.Select(h => (h.DateTime, h.DateTime.AddSeconds(1))), s.SessionStart, s.SessionEnd), s.SessionStart, s.SessionEnd);
                    var heal = Match(s)?.Players.FirstOrDefault(p => p.Id == who.PlayerId)?.HealDone ?? 0;
                    var whoId = who.PlayerId;
                    <div class="hb-hero">
                        <div class="hb-big">
                            <b class="teal">@Fmt(who.TotalDamage)</b><small>урон</small>
                            <b>@((Math.Min(1, active) * 100).ToString("0", CultureInfo.InvariantCulture))%</b><small>активности</small>
                            <b class="green">@Fmt(heal / Math.Max(1, s.Duration.TotalSeconds))</b><small>HPS</small>
                            @if (who.CombatPower > 0) { <small class="gs">GS @who.CombatPower.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"))</small> }
                        </div>
                        <div class="hb-hero-row">
                            <span class="hb-target">@Title(s) <b>@Fmt(who.TotalDamage)</b></span>
                            <span class="hb-grow"></span>
                            <button type="button" class="hb-view" @onclick="() => Views.Open(HistoryViewWindow.Rotation, selected, whoId)">Ротация умений <i>↗</i></button>
                            <button type="button" class="hb-view" @onclick="() => Views.Open(HistoryViewWindow.Buffs, selected, whoId)">Хронология баффов <i>↗</i></button>
                            <button type="button" class="hb-view" @onclick="() => Views.Open(HistoryViewWindow.PerSkill, selected, whoId)">Баффы по умениям <i>↗</i></button>
                            <button type="button" class="hb-view" @onclick="() => Views.Open(HistoryViewWindow.Replay, selected, whoId)">Повтор боя <i>↗</i></button>
                        </div>
                        <div class="hb-sumbox">
                            <div>@Clock(s.Duration) · @Fmt(who.DamagePerSecond) DPS · @castCount применений · @who.HitCount попаданий</div>
                            <div class="hb-rates">Крит <b>@P(who.CriticalRate)</b> Парир. <b>@P(who.ParryRate)</b> Спина <b>@P(who.BackAttackRate)</b> Фронт <b>@P(who.FrontAttackRate)</b> Идеал. <b>@P(who.PerfectRate)</b> Двойн. <b>@P(who.DoubleDamageRate)</b></div>
                        </div>
                    </div>
                    <div class="hb-table hb-skills">
                        <div class="hb-tr hb-th"><span>Умение</span><span>Спец.</span><span>Урон</span><span>%</span><span>Примен.</span><span>Мульти</span><span>Крит</span><span>Макс</span><span>Сред</span><span>Парир.</span></div>
                        @foreach (var k in skills)
                        {
                            <div class="hb-tr">
                                <i class="hb-fill" style="width:@Pct(k.TotalDamage, skills[0].TotalDamage)"></i>
                                <span class="hb-name">@if (!string.IsNullOrEmpty(k.SkillIcon)) { <img class="hb-skill-icon" src="@k.SkillIcon" alt="" /> }@k.SkillName
                                    @if (Options.Current.ShowSkillWarnings && SkillWarnings.RareCrit(k.CriticalRate, who.CriticalRate, k.HitCount))
                                    {
                                        <i class="hb-warn crit" title="@($"Критует {P(k.CriticalRate)} — меньше половины вашего крита ({P(who.CriticalRate)})")">редкий крит</i>
                                    }
                                    @if (Options.Current.ShowSkillWarnings && SkillWarnings.OftenParried(k.ParryRate, k.HitCount))
                                    {
                                        <i class="hb-warn parry" title="@($"Парируется {P(k.ParryRate)} ударов")">часто парируют</i>
                                    }
                                </span>
                                <span class="hb-spec">@foreach (var f in k.SpecializationFlags) { <i class="@(f ? "on" : "")"></i> }</span>
                                <b>@Fmt(k.TotalDamage)</b><span>@P(k.DamagePercentage)</span><span>@(k.HitCount)×</span>
                                <span>@(k.MultihitHits > 0 ? P(k.MultihitRate) : "—")</span><span>@P(k.CriticalRate)</span>
                                <span>@Fmt(k.MaxHit)</span><span>@Fmt(k.AverageDamage)</span><span>@P(k.ParryRate)</span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                var fight = Match(s);
                @if (tab == "summary")
                {
                    var players = s.PlayerStats.ToList();
                    var byId = players.ToDictionary(p => p.PlayerId);
                    var me = players.FirstOrDefault(p => p.IsUser)?.PlayerId;
                    RankRow Row(long id, double v, string text) =>
                        new(id, byId.TryGetValue(id, out var ps) ? ps.PlayerName : $"Игрок {id}", byId.TryGetValue(id, out var pc) ? pc.ClassId : 0, v, text);
                    var fp = fight?.Players ?? [];
                    var heal = fp.Where(p => p.HealDone > 0).OrderByDescending(p => p.HealDone).Select(p => Row(p.Id, p.HealDone, Fmt(p.HealDone))).ToList();
                    var got = fp.Where(p => p.HealReceived > 0).OrderByDescending(p => p.HealReceived).Select(p => Row(p.Id, p.HealReceived, Fmt(p.HealReceived))).ToList();
                    var taken = fp.Where(p => p.DamageTaken > 0).OrderByDescending(p => p.DamageTaken).Select(p => Row(p.Id, p.DamageTaken, Fmt(p.DamageTaken))).ToList();
                    var hits = players.Select(p => (p, Top: s.SkillStatsByPlayer.TryGetValue(p.PlayerId, out var ks) ? ks.OrderByDescending(k => k.MaxHit).FirstOrDefault() : null))
                        .Where(x => x.Top is { MaxHit: > 0 }).OrderByDescending(x => x.Top!.MaxHit).ToList();
                    var strong = hits.Select(x => Row(x.p.PlayerId, x.Top!.MaxHit, Fmt(x.Top.MaxHit))).ToList();
                    var openers = players.Where(p => p.FirstHit > DateTime.MinValue).OrderBy(p => p.FirstHit).ToList();
                    var first = openers.Select(p => Row(p.PlayerId, 1, p == openers[0] ? "0.0s" : "+" + (p.FirstHit - openers[0].FirstHit).TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) + "s")).ToList();
                    var healTotal = fp.Sum(p => p.HealDone);
                    var takenTotal = fp.Sum(p => p.DamageTaken);
                    var lead2 = got.Count > 0 ? fp.First(p => p.Id == got[0].Id) : null;
                    <div class="hb-grid hb-sum">
                        @RankCard("♥", "Больше всего лечения", "heal", heal, heal.Count > 0 ? $"{Share(heal[0].Value, healTotal)} лечения группы" : null, me, fight is null)
                        @RankCard("✚", "Больше всего получено лечения", "rheal", got, lead2 is null ? null : $"Из них своё: {Fmt(lead2.SelfHeal)}", me, fight is null)
                        @RankCard("⛉", "Больше всего получено урона", "taken", taken, taken.Count > 0 ? $"{Share(taken[0].Value, takenTotal)} урона, полученного группой" : null, me, fight is null)
                        @RankCard("ϟ", "Самый сильный удар", "hit", strong, hits.Count > 0 ? hits[0].Top!.SkillName : null, me, false)
                        @RankCard("⚑", "Первый удар", "first", first, first.Count > 0 ? "Начало боя" : null, me, false)
                        <div class="hb-card">
                            <div class="hb-card-title"><i class="hb-ct">∿</i>Бой</div>
                            <div class="hb-stat"><span>Длительность</span><b>@Clock(s.Duration)</b></div>
                            <div class="hb-stat"><span>Урон группы</span><b>@Fmt(players.Sum(p => p.TotalDamage))</b></div>
                            <div class="hb-stat"><span>DPS группы</span><b>@Fmt(players.Sum(p => p.TotalDamage) / Math.Max(1, s.Duration.TotalSeconds))</b></div>
                            <div class="hb-stat"><span>Лечение</span><b>@(fight is null ? "—" : Fmt(healTotal))</b></div>
                            <div class="hb-stat"><span>Получено урона</span><b>@(fight is null ? "—" : Fmt(takenTotal))</b></div>
                            <div class="hb-stat"><span>Смерти</span><b>@players.Sum(p => p.PlayerDeaths)</b></div>
                        </div>
                    </div>
                }
                else if (tab == "deaths")
                {
                    var dead = s.PlayerStats.Where(p => p.PlayerDeaths > 0).OrderByDescending(p => p.PlayerDeaths).ToList();
                    <div class="hb-table">
                        @if (dead.Count == 0) { <p class="hb-empty">В этом бою никто не умер.</p> }
                        @foreach (var p in dead)
                        {
                            <div class="hb-row hb-row--big @(p.IsUser ? "me" : "")"><span class="hb-icon" style="background-image:url('/images/classes/@(p.ClassId).png')"></span><span class="hb-row-name">@p.PlayerName</span><b>💀 @p.PlayerDeaths</b></div>
                        }
                    </div>
                }
                else if (fight is null)
                {
                    <p class="hb-empty">Лечение и полученный урон метр собирает с версии с «Итогами боя» и до перезапуска — для этого боя их нет.</p>
                }
                else
                {
                    Func<FightPlayer, long> value = tab == "heal" ? p => p.HealDone : p => p.DamageTaken;
                    var rows = fight.Players.Where(p => value(p) > 0).OrderByDescending(value).ToList();
                    var max = rows.Count > 0 ? value(rows[0]) : 1;
                    var names = s.PlayerStats.ToDictionary(p => p.PlayerId);
                    <div class="hb-table">
                        @if (rows.Count == 0) { <p class="hb-empty">В этом бою — ничего.</p> }
                        @foreach (var p in rows)
                        {
                            names.TryGetValue(p.Id, out var ps);
                            <div class="hb-row hb-row--big @(ps?.IsUser == true ? "me" : "")">
                                <i class="hb-fill @(tab == "heal" ? "heal" : "taken")" style="width:@Pct(value(p), max)"></i>
                                <span class="hb-icon" style="background-image:url('/images/classes/@(ps?.ClassId ?? 0).png')"></span>
                                <span class="hb-row-name">@(ps?.PlayerName ?? $"Игрок {p.Id}")@if (tab == "heal" && p.HealReceived > 0) { <small>получил @Fmt(p.HealReceived), своё @Fmt(p.SelfHeal)</small> }</span>
                                <b>@Fmt(value(p))</b>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    private static readonly (string Id, string Label)[] Tabs =
        [("damage", "Урон"), ("heal", "Лечение"), ("taken", "Получено"), ("summary", "Итоги"), ("deaths", "Смерти")];

    private string tab = "damage";
    private string query = "";
    private IReadOnlyList<HistorySessionListItem> items = [];
    private Guid? selected;
    private HistorySessionSnapshot? snap;
    private long? player;
    private System.Threading.Timer? tick;

    protected override void OnInitialized()
    {
        LoadList();
        Select(Window.RequestedSession, Window.RequestedPlayer);
        Window.Requested += OnRequested;
        tick = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (selected is null) { RefreshCurrent(); StateHasChanged(); }
        }), null, 1000, 1000);
    }

    private void OnRequested() => InvokeAsync(() => { LoadList(); Select(Window.RequestedSession, Window.RequestedPlayer); tab = "damage"; StateHasChanged(); });

    private void OnSearch(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        LoadList();
    }

    private void LoadList()
    {
        try { items = Store.GetSessionPage(null, null, query.Length > 0 ? query : null, 0, 150); }
        catch (Exception) { items = []; }
    }

    private void Select(Guid? id, long? playerId = null)
    {
        selected = id;
        snap = id is { } g ? Store.GetSession(g) : null;
        if (id is null) RefreshCurrent();
        player = playerId ?? snap?.PlayerStats.FirstOrDefault(p => p.IsUser)?.PlayerId ?? snap?.PlayerStats.OrderByDescending(p => p.TotalDamage).FirstOrDefault()?.PlayerId;
    }

    private void RefreshCurrent()
    {
        if (Sessions.GetActiveTargetSession() is { } live) snap = HistorySessionSnapshot.From(live);
        player ??= snap?.PlayerStats.FirstOrDefault(p => p.IsUser)?.PlayerId;
    }

    /// <summary>The fork's fight summary (healing, damage taken) for this fight, when the meter saw it.</summary>
    private FightSummary? Match(HistorySessionSnapshot s) =>
        Modes.Fight.History().FirstOrDefault(f => f.Start <= s.SessionEnd.AddSeconds(30) && f.Start + f.Duration >= s.SessionStart.AddSeconds(-30));

    private sealed record RankRow(long Id, string Name, int ClassId, double Value, string Text);

    private static string Share(double part, double total) => (part * 100 / Math.Max(1, total)).ToString("0", CultureInfo.InvariantCulture) + "%";

    /// <summary>One "Итоги" card like the reference: the leader with a note, then the top five with bars; my row is
    /// outlined and added below when I'm not in the top five.</summary>
    private static RenderFragment RankCard(string icon, string title, string tone, IReadOnlyList<RankRow> rows, string? note, long? me, bool noData) => __builder =>
    {
        <div class="hb-card hb-rank-card @tone">
            <div class="hb-card-title"><i class="hb-ct">@icon</i>@title</div>
            @if (noData || rows.Count == 0)
            {
                <div class="hb-lead-note">@(noData ? "Метр не видел лечение и полученный урон в этом бою." : "Нет данных.")</div>
            }
            else
            {
                var max = Math.Max(1, rows[0].Value);
                var mine = rows.Select((r, i) => (r, i)).FirstOrDefault(x => x.r.Id == me);
                var shown = rows.Take(5).Select((r, i) => (r, i)).ToList();
                if (me is not null && mine.r is not null && mine.i >= 5) shown.Add(mine);
                <div class="hb-lead"><span class="hb-icon" style="background-image:url('/images/classes/@(rows[0].ClassId).png')"></span><b>@rows[0].Name</b><em>@rows[0].Text</em></div>
                @if (note is not null) { <div class="hb-lead-note">@note</div> }
                <div class="hb-ranks">
                    @foreach (var (r, i) in shown)
                    {
                        <div class="hb-rank @(r.Id == me ? "me" : "")">
                            <i class="hb-fill" style="width:@(tone == "first" ? "100%" : Pct(r.Value, max))"></i>
                            <span class="hb-rank-n">@(i + 1)</span>
                            <span class="hb-icon" style="background-image:url('/images/classes/@(r.ClassId).png')"></span>
                            <span class="hb-row-name">@r.Name</span>
                            <b>@r.Text</b>
                        </div>
                    }
                </div>
            }
        </div>
    };

    private static string Title(HistorySessionSnapshot s) => string.IsNullOrWhiteSpace(s.TargetName) ? "Бой" : s.TargetName;

    private static string Fmt(double v) => AionDpsMeter.UI.Utils.DamageFormatter.Format((long)v);

    private static string P(double v) => v.ToString("0.0", CultureInfo.InvariantCulture) + "%";

    private static string Pct(double part, double max) => (part * 100.0 / Math.Max(1, max)).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string Clock(TimeSpan t) => t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");

    public void Dispose()
    {
        tick?.Dispose();
        Window.Requested -= OnRequested;
    }
}
