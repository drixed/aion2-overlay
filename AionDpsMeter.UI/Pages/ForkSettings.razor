@* aion2-overlay fork: new file (see FORK_CHANGES.md). The fork's settings, rendered inside RATmeter's own settings
   window with its components, one block per tab. *@
@using AionDpsMeter.Timers.Feed
@using AionDpsMeter.Timers.Overlay
@using AionDpsMeter.UI.Pages.Components

@switch (Section)
{
    case "appearance":
        <div class="fs-label fs-label--spaced">ПОЛОСЫ И ЦВЕТА</div>
        <SettingRow Title="Стиль полос" Description="Классика — как сейчас; толстые; тонкие линии; шкала справа от имени; таблица">
            <ValueSlot>
                <div class="fs-segmented">
                    @foreach (var (style, label) in BarStyles)
                    {
                        <button type="button" class="fs-segmented__option @(O.BarStyle == style ? "is-selected" : "")" @onclick="() => Set(o => o.BarStyle = style)">@label</button>
                    }
                </div>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Высота полос" Description="@($"{O.BarHeight}%")">
            <ValueSlot><input class="fs-range" type="range" min="60" max="160" step="10" value="@O.BarHeight" @onchange="e => SetInt(e.Value, v => Set(o => o.BarHeight = v))" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Тема" Description="Цвета окна: обычная, минимальная (без подложек), плотная, светлая">
            <ValueSlot>
                <div class="fs-segmented">
                    @foreach (var (theme, label) in Themes)
                    {
                        <button type="button" class="fs-segmented__option @(O.Theme == theme ? "is-selected" : "")" @onclick="() => Set(o => o.Theme = theme)">@label</button>
                    }
                </div>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Шрифт" Description="Шрифты, которые есть в любой Windows">
            <ValueSlot>
                <div class="fs-segmented">
                    @foreach (var (font, label) in Fonts)
                    {
                        <button type="button" class="fs-segmented__option @(O.Font == font ? "is-selected" : "")" @onclick="() => Set(o => o.Font = font)">@label</button>
                    }
                </div>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Размер шрифта" Description="@($"{O.FontSize} px")">
            <ValueSlot><input class="fs-range" type="range" min="10" max="16" step="1" value="@O.FontSize" @onchange="e => SetInt(e.Value, v => Set(o => o.FontSize = v))" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Акцентный цвет" Description="Полоса HP босса и выделение в меню">
            <ValueSlot>
                <span class="fs-hotkey">
                    <input type="color" class="fs-color" value="@(string.IsNullOrEmpty(O.AccentColor) ? "#ff6b81" : O.AccentColor)" @onchange="e => Set(o => o.AccentColor = e.Value?.ToString() ?? string.Empty)" />
                    <button type="button" class="fs-segmented__option fs-button" @onclick="() => Set(o => o.AccentColor = string.Empty)">Сброс</button>
                </span>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Цвет фона" Description="Фон главного окна; прозрачность — ползунком «Прозрачность окна» выше" IsLast="true">
            <ValueSlot>
                <span class="fs-hotkey">
                    <input type="color" class="fs-color" value="@(string.IsNullOrEmpty(O.BackgroundColor) ? "#121018" : O.BackgroundColor)" @onchange="e => Set(o => o.BackgroundColor = e.Value?.ToString() ?? string.Empty)" />
                    <button type="button" class="fs-segmented__option fs-button" @onclick="() => Set(o => o.BackgroundColor = string.Empty)">Сброс</button>
                </span>
            </ValueSlot>
        </SettingRow>

        <div class="fs-label fs-label--spaced">СПИСОК ИГРОКОВ</div>
        <SettingRow Title="Порядок" Description="Где первое место: сверху или снизу (удобно, если окно внизу экрана)">
            <ValueSlot>
                <div class="fs-segmented">
                    <button type="button" class="fs-segmented__option @(!O.FirstPlaceAtBottom ? "is-selected" : "")" @onclick="() => Set(o => o.FirstPlaceAtBottom = false)">Первый сверху</button>
                    <button type="button" class="fs-segmented__option @(O.FirstPlaceAtBottom ? "is-selected" : "")" @onclick="() => Set(o => o.FirstPlaceAtBottom = true)">Первый снизу</button>
                </div>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Я всегда сверху" Description="Твоя строка у заголовка, место по урону остаётся своим">
            <ValueSlot><ToggleSwitch Checked="@O.KeepMeOnTop" CheckedChanged="v => Set(o => o.KeepMeOnTop = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Номера мест" Description="1, 2, 3… перед именем">
            <ValueSlot><ToggleSwitch Checked="@O.RankNumbers" CheckedChanged="v => Set(o => o.RankNumbers = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Рядом с ником" Description="БМ — боевая мощь, ГС — уровень снаряжения (игра присылает его только для членов группы)">
            <ValueSlot>
                <div class="fs-segmented">
                    @foreach (var (mode, label) in PowerModes)
                    {
                        <button type="button" class="fs-segmented__option @(O.PowerColumn == mode ? "is-selected" : "")" @onclick="() => Set(o => o.PowerColumn = mode)">@label</button>
                    }
                </div>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Скрыть общий урон" Description="Убирает столбец общего урона из строк игроков" IsLast="true">
            <ValueSlot><ToggleSwitch Checked="@O.HideTotalDamage" CheckedChanged="v => Set(o => o.HideTotalDamage = v)" /></ValueSlot>
        </SettingRow>

        <div class="fs-label fs-label--spaced">ОКНО</div>
        <SettingRow Title="Компактная полоса" Description="Главное окно — только шапка и твоя строка">
            <ValueSlot><ToggleSwitch Checked="@O.Compact" CheckedChanged="v => Set(o => o.Compact = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Компактно вне боя" Description="Вне боя окно само сворачивается в полосу, в бою разворачивается">
            <ValueSlot><ToggleSwitch Checked="@O.AutoCompact" CheckedChanged="v => Set(o => o.AutoCompact = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Режим фокуса" Description="В бою скрывает шапку, объявления и разлом; наведи курсор — появятся">
            <ValueSlot><ToggleSwitch Checked="@O.FocusMode" CheckedChanged="v => Set(o => o.FocusMode = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Только поверх игры" Description="Оверлей поверх остальных окон, только пока активна игра">
            <ValueSlot><ToggleSwitch Checked="@O.OnlyOverGame" CheckedChanged="v => Set(o => o.OnlyOverGame = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Масштаб интерфейса" Description="Главное окно и окно таймеров; высота подстраивается сама">
            <ValueSlot>
                <div class="slider-field">
                    <input type="range" min="80" max="150" step="5" value="@O.UiScale" @onchange="e => SetScale(e.Value)" />
                    <span class="slider-field__value">@O.UiScale%</span>
                </div>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Расти вверх" Description="Нижний край окна стоит на месте, окно растёт вверх — для метра внизу экрана">
            <ValueSlot><ToggleSwitch Checked="@O.GrowUpward" CheckedChanged="v => Set(o => o.GrowUpward = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Прозрачность при сквозном клике" Description="@($"{O.LockedOpacity}% — когда клики проходят сквозь окна в игру (горячая клавиша «Сквозной клик»)")">
            <ValueSlot><input class="fs-range" type="range" min="10" max="100" step="5" value="@O.LockedOpacity" @onchange="e => SetInt(e.Value, v => Set(o => o.LockedOpacity = v))" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Скрыть полосу HP босса" Description="В карточке босса останутся цифры, без полосы" IsLast="true">
            <ValueSlot><ToggleSwitch Checked="@O.HideBossHpBar" CheckedChanged="v => Set(o => o.HideBossHpBar = v)" /></ValueSlot>
        </SettingRow>
        break;

    case "tracking":
        <div class="fs-label fs-label--spaced">ЧИСЛА</div>
        <SettingRow Title="Расчёт DPS" Description="eDPS — урон за всё время боя; aDPS — только за твоё активное время, от первого удара до последнего">
            <ValueSlot>
                <div class="fs-segmented">
                    <button type="button" class="fs-segmented__option @(O.DpsMode == DpsMode.Effective ? "is-selected" : "")" @onclick="() => Set(o => o.DpsMode = DpsMode.Effective)">eDPS</button>
                    <button type="button" class="fs-segmented__option @(O.DpsMode == DpsMode.Active ? "is-selected" : "")" @onclick="() => Set(o => o.DpsMode = DpsMode.Active)">aDPS</button>
                </div>
            </ValueSlot>
        </SettingRow>
        <SettingRow Title="Только моя группа" Description="Только ты и члены группы; проценты, DPS группы и сводка — по группе">
            <ValueSlot><ToggleSwitch Checked="@O.OnlyMyParty" CheckedChanged="v => Set(o => o.OnlyMyParty = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Показывать DPS группы" Description="Суммарный DPS в карточке боя, когда игроков больше одного">
            <ValueSlot><ToggleSwitch Checked="@O.ShowPartyDps" CheckedChanged="v => Set(o => o.ShowPartyDps = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Показывать таймер ярости" Description="«До ярости» в карточке боя с боссом">
            <ValueSlot><ToggleSwitch Checked="@O.ShowEnrage" CheckedChanged="v => Set(o => o.ShowEnrage = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Карточка для всех целей" Description="HP и «До победы» и для обычных мобов, не только для боссов">
            <ValueSlot><ToggleSwitch Checked="@O.CardForAllTargets" CheckedChanged="v => Set(o => o.CardForAllTargets = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Рекорды по боссам" Description="В карточке босса — рекорд и темп относительно него; после боя — плашка «Новый рекорд». Список — во вкладке «Рекорды»">
            <ValueSlot><ToggleSwitch Checked="@O.ShowRecords" CheckedChanged="v => Set(o => o.ShowRecords = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Питомцы" Description="Бьёшь монстра, чей питомец ещё не прокачан, — над списком видно его уровень и души; новый уровень — плашка и звук. Метр сам учится, какой монстр какого питомца">
            <ValueSlot><ToggleSwitch Checked="@O.ShowPets" CheckedChanged="v => Set(o => o.ShowPets = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Бой окончен через" Description="@($"{O.FightIdleSeconds} с без ударов — бой завершается и уходит в историю (по умолчанию 45)")">
            <ValueSlot><input class="fs-range" type="range" min="10" max="120" step="5" value="@O.FightIdleSeconds" @onchange="e => SetInt(e.Value, v => Set(o => o.FightIdleSeconds = v))" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Формат сводки" Description="Как копируется итог боя: одним сообщением для чата или по игроку в строке" IsLast="true">
            <ValueSlot>
                <div class="fs-segmented">
                    <button type="button" class="fs-segmented__option @(!O.SummaryMultiline ? "is-selected" : "")" @onclick="() => Set(o => o.SummaryMultiline = false)">Одна строка</button>
                    <button type="button" class="fs-segmented__option @(O.SummaryMultiline ? "is-selected" : "")" @onclick="() => Set(o => o.SummaryMultiline = true)">Несколько</button>
                </div>
            </ValueSlot>
        </SettingRow>

        <div class="fs-label fs-label--spaced">МАНЕКЕН</div>
        <SettingRow Title="Манекен при ударе по чучелу" Description="Ударил тренировочное чучело — окно само показывает замер фиксированной длины (режим «Манекен» в меню у заголовка)">
            <ValueSlot><ToggleSwitch Checked="@O.AutoDummy" CheckedChanged="v => Set(o => o.AutoDummy = v)" /></ValueSlot>
        </SettingRow>
        <SettingRow Title="Длительность замера на манекене" Description="Замер начинается с первого удара и считает ровно это время, чтобы замеры можно было сравнивать" IsLast="true">
            <ValueSlot>
                <div class="fs-segmented">
                    @foreach (var seconds in new[] { 30, 60, 120, 180 })
                    {
                        <button type="button" class="fs-segmented__option @(O.DummyRunSeconds == seconds ? "is-selected" : "")" @onclick="() => Set(o => o.DummyRunSeconds = seconds)">@(seconds < 60 ? $"{seconds} с" : $"{seconds / 60} мин")</button>
                    }
                </div>
            </ValueSlot>
        </SettingRow>
        break;

    case "hotkeys":
        <div class="fs-label fs-label--spaced">ГЛОБАЛЬНЫЕ ГОРЯЧИЕ КЛАВИШИ</div>
        @for (var i = 0; i < Hotkeys.Count; i++)
        {
            var hotkey = Hotkeys[i];
            <SettingRow Title="@hotkey.Title" Description="@hotkey.Description" IsLast="@(i == Hotkeys.Count - 1)">
                <ValueSlot>
                    <span class="fs-hotkey">
                        <input class="hotkey-field @(capturing == hotkey.Id ? "is-active" : "")" readonly
                               value="@Label(hotkey)"
                               @onfocus="() => capturing = hotkey.Id"
                               @onblur="() => capturing = null"
                               @onkeydown="e => OnKey(hotkey, e)" @onkeydown:preventDefault="true" />
                        @if (!string.IsNullOrEmpty(hotkey.Get()))
                        {
                            <button type="button" class="fs-clear" title="Очистить" @onclick="() => hotkey.Set(string.Empty)">×</button>
                        }
                    </span>
                </ValueSlot>
            </SettingRow>
        }
        break;

    case "timers":
        <div class="fs-label fs-label--spaced">СОБЫТИЯ В ГЛАВНОМ ОКНЕ</div>
        @foreach (var alert in AlertRows)
        {
            <SettingRow Title="@alert.Title" Description="@(alert.Kind == FeedKind.Boss ? "Строки полевых боссов в окне таймеров" : "Иконка внизу главного окна")">
                <ValueSlot><ToggleSwitch Checked="@Shown(alert)" CheckedChanged="v => SetShown(alert, v)" /></ValueSlot>
            </SettingRow>
        }
        <SettingRow Title="Время у событий всегда" Description="Отсчёт рядом с иконками разлома, шуго и других событий виден постоянно, а не только перед началом" IsLast="true">
            <ValueSlot><ToggleSwitch Checked="@O.EventTimesAlways" CheckedChanged="v => Set(o => o.EventTimesAlways = v)" /></ValueSlot>
        </SettingRow>

        <div class="fs-label fs-label--spaced">УВЕДОМЛЕНИЯ</div>
        <SettingRow Title="Звук оповещений" Description="Сигнал, когда до события остаётся заданное время">
            <ValueSlot><ToggleSwitch Checked="@O.Sound" CheckedChanged="v => Set(o => o.Sound = v)" /></ValueSlot>
        </SettingRow>
        @foreach (var alert in AlertRows)
        {
            <SettingRow Title="@alert.Title" Description="@alert.Description">
                <ValueSlot>
                    <span class="fs-hotkey">
                        <span class="number-field-wrap">
                            <input class="number-field" type="number" min="1" max="60" value="@O.LeadFor(alert.MuteKey, alert.Kind)" @onchange="e => SetLeadFor(alert.MuteKey, e.Value)" />
                            <span class="number-field__suffix">мин</span>
                        </span>
                        <select class="fs-select" value="@(O.SoundFor(alert.MuteKey).ToString())" @onchange="e => OnSoundPicked(alert.MuteKey, e.Value)" title="Звук">
                            @foreach (var (value, label) in WindowsSounds)
                            {
                                <option value="@value">@label</option>
                            }
                            @if (O.SoundFor(alert.MuteKey) is { File: not null } own)
                            {
                                <option value="@own.ToString()">@FileLabel(own)</option>
                            }
                            <option value="@PickFile">Свой файл…</option>
                        </select>
                        <button type="button" class="fs-segmented__option fs-button" title="Прослушать" @onclick="() => PlaySound(alert.MuteKey)">▶</button>
                        <ToggleSwitch Checked="@AlertOn(alert)" CheckedChanged="v => SetAlert(alert.MuteKey, v)" />
                    </span>
                </ValueSlot>
            </SettingRow>
        }

        <SettingRow Title="Питомец: новый уровень" Description="Звук, когда питомец поднимает уровень (вместе с плашкой в главном окне). Работает при включённых «Питомцах»">
            <ValueSlot>
                <span class="fs-hotkey">
                    <select class="fs-select" value="@(O.SoundFor(TimersOptions.PetLevelUpKey).ToString())" @onchange="e => OnSoundPicked(TimersOptions.PetLevelUpKey, e.Value)" title="Звук">
                        @foreach (var (value, label) in WindowsSounds)
                        {
                            <option value="@value">@label</option>
                        }
                        @if (O.SoundFor(TimersOptions.PetLevelUpKey) is { File: not null } petOwn)
                        {
                            <option value="@petOwn.ToString()">@FileLabel(petOwn)</option>
                        }
                        <option value="@PickFile">Свой файл…</option>
                    </select>
                    <button type="button" class="fs-segmented__option fs-button" title="Прослушать" @onclick="() => PlaySound(TimersOptions.PetLevelUpKey)">▶</button>
                    <ToggleSwitch Checked="@(!O.MutedIds.Contains(TimersOptions.PetLevelUpKey))" CheckedChanged="v => SetAlert(TimersOptions.PetLevelUpKey, v)" />
                </span>
            </ValueSlot>
        </SettingRow>

        <div class="fs-label fs-label--spaced">ОКНО ТАЙМЕРОВ БОССОВ</div>
        <SettingRow Title="Окно таймеров боссов" Description="Полевые боссы в отдельном окне; закрыть его можно и крестиком в его шапке" IsLast="true">
            <ValueSlot><ToggleSwitch Checked="@O.ShowBossTimers" CheckedChanged="v => Set(o => o.ShowBossTimers = v)" /></ValueSlot>
        </SettingRow>
        @if (O.HiddenIds.Count > 0)
        {
            <SettingRow Title="Скрытые строки" Description="Строки, скрытые крестиком в окне таймеров" IsLast="true">
                <ValueSlot>
                    <button type="button" class="fs-segmented__option fs-button" @onclick="ShowHidden">Вернуть (@O.HiddenIds.Count)</button>
                </ValueSlot>
            </SettingRow>
        }
        break;
}
